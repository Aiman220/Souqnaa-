# Server & Domain Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=https://www.souqnaa.com,https://admin.souqnaa.com,https://seller.souqnaa.com

# Cloudflare Routing & Domains
BACKEND_PUBLIC_URL=https://api.souqnaa.com
API_BASE_URL=https://api.souqnaa.com/api/v1
WEB_BASE_URL=https://www.souqnaa.com
ADMIN_BASE_URL=https://admin.souqnaa.com
SELLER_BASE_URL=https://seller.souqnaa.com
CLOUDFLARE_PROTECTION_ENABLED=true
CLOUDFLARE_HSTS_ENABLED=true

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/souqna_db?schema=public"

# Upstash Redis (Production / Staging TLS endpoint)
# Option A: Full Connection URI (Recommended for Upstash Redis)
REDIS_URL="rediss://default:your_upstash_redis_token_here@your-endpoint.upstash.io:6379"
# Option B: Distinct connection parameters
REDIS_HOST=your-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_token_here
REDIS_TLS=true
REDIS_KEY_PREFIX=souqna:prod:

# JWT Secrets & Expiry
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# File Upload & Cloudflare R2 Storage Provider (s3 | local)
STORAGE_PROVIDER=s3
UPLOAD_DIR=./uploads
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
AWS_REGION=auto
AWS_S3_BUCKET=souqnaa-assets
S3_PUBLIC_URL=https://assets.souqnaa.com

# Delivery Engine Defaults
DEFAULT_CURRENCY=YER
BASE_DELIVERY_FEE=400
FREE_DELIVERY_THRESHOLD=10000
DEFAULT_COMMISSION_RATE=0.10
MAX_DELIVERY_RADIUS_KM=50
EXPRESS_FEE_FIXED=500
MULTI_VENDOR_POLICY=PER_SELLER

# ==============================================================================
# SECURE ADMIN CREDENTIALS & FIRST SUPER_ADMIN BOOTSTRAP (RBAC)
# ==============================================================================
BOOTSTRAP_ADMIN_EMAIL=super@souqna.online
BOOTSTRAP_ADMIN_PASSWORD=StrongPassword@2026
BOOTSTRAP_ADMIN_NAME="Super Administrator"
BOOTSTRAP_ADMIN_FIRST_NAME=Super
BOOTSTRAP_ADMIN_LAST_NAME=Admin
BOOTSTRAP_ADMIN_PHONE=+966500000001
BOOTSTRAP_RECOVERY_KEY=a_secure_recovery_key_16_chars_minimum

# Map & Geocoding Provider
GEOCODING_PROVIDER=geoapify
ROUTING_PROVIDER=geoapify
GEOAPIF_API_KEY=your_geoapify_api_key_here
GEOAPIF_TILE_URL=https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=your_geoapify_api_key_here

# ==============================================================================
# SOUQNAA NOTIFICATION PLATFORM — EMAIL CONFIGURATION
# ==============================================================================
# SMTP Provider Settings (Gmail, Amazon SES, SendGrid, Mailgun, Postmark, Custom SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@souqnaa.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM_NAME="سوقناا"
EMAIL_FROM_ADDRESS=noreply@souqnaa.com

# ==============================================================================
# SOUQNAA NOTIFICATION PLATFORM — SMS CONFIGURATION
# ==============================================================================
# Supported providers: LOG (simulated in dev), TWILIO, UNIFONIC, YEMEN_SMS
SMS_PROVIDER=LOG
SMS_SENDER_ID=Souqnaa

# Twilio Credentials (when SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Unifonic Credentials (when SMS_PROVIDER=UNIFONIC)
UNIFONIC_APP_SID=your_unifonic_app_sid_here

# Yemeni SMS Gateway Credentials (when SMS_PROVIDER=YEMEN_SMS)
YEMEN_SMS_API_KEY=your_yemen_sms_api_key_here
YEMEN_SMS_API_URL=https://sms.yemen-gateway.com/api/send

# Marketing SMS Regulations & Frequency Limits
# Quiet Hours: No promotional SMS between 21:00 (9 PM) and 09:00 (9 AM) local time
MARKETING_SMS_QUIET_START=21
MARKETING_SMS_QUIET_END=9
# Frequency limit: minimum hours between marketing SMS per phone number
MARKETING_SMS_COOLDOWN_HOURS=48
# Mandatory regulatory opt-out instruction appended to marketing text
SMS_OPTOUT_TEXT="\nلإلغاء الاشتراك أرسل قف إلى 1234"

# ==============================================================================
# SOUQNAA AUTHENTICATION & OTP INTEGRATION
# ==============================================================================
# OTP Expiry in seconds (Default: 600 = 10 minutes)
OTP_EXPIRY_SECONDS=600
# Resend cooldown in seconds (Default: 60 = 1 minute)
OTP_COOLDOWN_SECONDS=60
# Password reset code validity in seconds (Default: 900 = 15 minutes)
PASSWORD_RESET_EXPIRY_SECONDS=900
# Fixed dev bypass OTP for local testing (enabled only in non-production)
OTP_DEV_BYPASS_CODE=123456

# ==============================================================================
# GOOGLE AUTHENTICATION & OAUTH 2.0 (Customer & Seller Apps)
# ==============================================================================
GOOGLE_CLIENT_ID_WEB=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Aliases:
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=your_google_server_client_id.apps.googleusercontent.com

# ==============================================================================
# FACEBOOK AUTHENTICATION & GRAPH API (Customer & Seller Apps)
# ==============================================================================
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token_here

# ==============================================================================
# SOUQNAA NOTIFICATION PLATFORM — PUSH NOTIFICATIONS (FCM HTTP v1)
# ==============================================================================
# Firebase Project ID (from Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=souqnaa
# Path to Google Service Account JSON file OR inline JSON string:
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json
# Alternatively, specify service account credentials individually:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@souqnaa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_here\n-----END PRIVATE KEY-----\n"
# Legacy FCM Server Key fallback (optional):
# FCM_SERVER_KEY=your_legacy_fcm_server_key_here
