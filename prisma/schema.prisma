// ==========================================
// 1. AUTH & USERS
// ==========================================

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  phone            String?      @unique
  passwordHash     String
  firstName        String
  lastName         String
  avatar           String?
  role             UserRoleType @default(CUSTOMER)
  isVerified       Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer         Customer?
  seller           Seller?
  socialIdentities SocialIdentity[]
  addresses        Address[]
  notifications    Notification[]
  notificationTokens NotificationToken[]
  notificationDevices NotificationDevice[]
  notificationPreferences NotificationPreference[]
  conversations    ConversationMember[]
  sentMessages     Message[]            @relation("SentMessages")
  reportedMessages MessageReport[]      @relation("ReportedMessages")
  productReviews   ProductReview[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  reviewReports    ReviewReport[]       @relation("ReviewReports")
  auditLogs        AuditLog[]
  userRoles        UserRole[]
  wishlist         Wishlist?
  wishlistAlerts   WishlistAlert[]
  cart             Cart?
  orders           Order[]
  disputes         Dispute[]            @relation("CustomerDisputes")
  productReports   ProductReport[]
  flashSaleReservations FlashSaleReservation[]
  customerVouchers CustomerVoucher[]
  voucherReservations VoucherReservation[]
  voucherRedemptions VoucherRedemption[]

  // Social Follow System
  followedBy       SocialFollow[]    @relation("Followed")    // Others who follow this user
  following        SocialFollow[]    @relation("Follower")    // Users this user follows
  blockedByUsers   UserBlock[]       @relation("Blocked")     // Users who blocked this user
  blockingUsers    UserBlock[]       @relation("Blocker")     // Users this user blocked
  followCounters   FollowCounter[]                           // Denormalized counters
  followPrivacy    UserFollowPrivacy?                        // Privacy settings
  searchHistory    SearchHistory[]
  refundRequests   RefundRequest[]   @relation("CustomerRefundRequests")
  refundMessages   RefundMessage[]   @relation("RefundMessageSender")
  refundEvidences  RefundEvidence[]  @relation("RefundEvidenceUploader")
  refundHistories  RefundStatusHistory[] @relation("RefundHistoryActor")
  walletAccount    WalletAccount?
  savedWallets     CustomerSavedWallet[]
  customerRefundDecisions CustomerRefundDecision[]
  manualTransfersRequested ManualWalletTransferRequest[] @relation("CustomerManualTransfers")
  manualTransfersAssigned ManualWalletTransferRequest[] @relation("AdminAssignedManualTransfers")
  manualTransfersVerified ManualWalletTransferRequest[] @relation("AdminVerifiedManualTransfers")
  transferProofs   TransferProof[]   @relation("TransferProofUploader")
  refundAdjustments RefundAdjustment[] @relation("AdminRefundAdjustments")
  walletLedgerEntriesCreated WalletLedgerEntry[] @relation("WalletLedgerEntryCreator")
  customerWithdrawals        CustomerWalletWithdrawal[] @relation("CustomerWithdrawals")
  adminCustomerWithdrawals   CustomerWalletWithdrawal[] @relation("AdminCustomerWithdrawals")
  deposits                   WalletDeposit[]            @relation("UserDeposits")
  adminReviewedDeposits      WalletDeposit[]            @relation("AdminReviewedDeposits")

  // Recommendation Engine Relations
  recommendationProfile      UserRecommendationProfile?
  recommendationEvents       RecommendationEvent[]

  // Support Center Relations
  supportAgent               SupportAgent?
  supportRatings             SupportRating[]

  // SOUQNAA Coins & Rewards Relations
  rewardAccount              RewardAccount?
  coinTransactions           CoinTransaction[]
  coinReservations           CoinReservation[]
  coinLots                   CoinLot[]
  dailyCheckins              DailyCheckin[]
  missionProgress            CustomerMissionProgress[]
  referralsMade              ReferralRecord[]              @relation("ReferrerUser")
  referredByRecord           ReferralRecord?               @relation("RefereeUser")
  rewardAuditLogsCreated     RewardAuditLog[]              @relation("RewardAuditCreator")
  rewardAuditLogsTargeted    RewardAuditLog[]              @relation("RewardAuditTarget")

  // First Order Free Shipping Relations
  promotionReservations      PromotionReservation[]
  promotionUsages            PromotionUsage[]
  promotionEligibilityAudits PromotionEligibilityAudit[]
  promotionConfigAudits      PromotionConfigAuditLog[]
  shippingPromotionAudits    ShippingPromotionAuditLog[]   @relation("ShippingPromotionAuditActor")

  // Customer Membership & VIP Tiers Relations
  membership                 CustomerMembership?
  membershipOverrides        MembershipOverride[]
  membershipAuditLogs        MembershipAuditLog[]

  // Customer Action Center Relations
  actionDismissals           CustomerActionDismissal[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model SocialIdentity {
  id                    String            @id @default(uuid())
  provider              SocialProvider
  providerUserId        String
  accountType           SocialAccountType
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerEmail         String?
  providerEmailVerified Boolean           @default(false)
  displayName           String?
  avatarUrl             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lastLoginAt           DateTime          @default(now())

  @@unique([provider, providerUserId, accountType])
  @@index([userId])
  @@index([provider, providerUserId])
  @@index([providerEmail])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           // e.g. 'products:create', 'orders:read'
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seller {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType   String?
  crNumber       String?        // Commercial Registration / Freelance License
  taxNumber      String?
  status         SellerStatus   @default(PENDING_VERIFICATION)
  commissionRate Float          @default(0.10) // 10%
  idNumber          String?        // National ID / Iqama / Passport
  idFrontUrl        String?        // National ID front image URL
  idBackUrl         String?        // National ID back image URL
  idSelfieUrl       String?        // Selfie holding ID image URL
  businessDocUrl    String?        // CR or Freelance certificate document URL
  verificationNotes String?        // Admin verification approval notes
  rejectionReason   String?        // Admin rejection reason
  isOnboarded       Boolean        @default(false) // Completed onboarding wizard
  verifiedAt     DateTime?
  // Seller Cash On Delivery & Financial Standing
  cashOnDeliveryEnabled       Boolean              @default(true)
  isFinanciallyRestricted     Boolean              @default(false)
  financialRestrictionReason  String?
  financialRestrictedAt       DateTime?
  financialRestrictionLevel   String?              @default("NORMAL") // NORMAL, WARNING, CRITICAL, RESTRICTED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  stores            Store[]
  sellerOrders      SellerOrder[]
  balance           SellerBalance?
  withdrawals       Withdrawal[]
  savedWallets      SellerSavedWallet[]
  disputes          Dispute[]            @relation("SellerDisputes")
  sellerResponses   ReviewSellerResponse[]
  flashSaleItems    FlashSaleItem[]
  flashSaleSubmissions FlashSaleSellerSubmission[]
  vouchers          Voucher[]
  voucherRedemptions VoucherRedemption[]
  // Seller Marketing Promotions
  promotions        SellerPromotion[]
  campaignProducts  CampaignProduct[]
  campaignSellers   CampaignSeller[]
  refundRequests    RefundRequest[]      @relation("SellerRefundRequests")
  sellerRefundDecisions SellerRefundDecision[]
  financialTransactions FinancialTransaction[]
  deposits              WalletDeposit[]      @relation("SellerDeposits")
  outstandings          SellerOutstanding[]  @relation("SellerOutstandings")
  recommendationEvents  RecommendationEvent[]
  // SOUQNAA Coins & Rewards Relations
  coinCampaigns         CoinCampaign[]
  sellerRewardBudget    SellerRewardBudget?
  financialStatements   FinancialStatement[]
  settlements           Settlement[]
  performance           SellerPerformance?
  performanceSnapshots  SellerPerformanceSnapshot[]

  @@index([status])
  @@index([isFinanciallyRestricted])
}

model Store {
  id                 String    @id @default(uuid())
  sellerId           String
  seller             Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name               String
  slug               String    @unique
  description        String?
  logo               String?
  cover              String?
  rating             Float     @default(0.0)
  reviewCount        Int       @default(0)
  isActive           Boolean   @default(true)
  isVerified         Boolean   @default(false)
  // Store operational & availability settings
  isOpen             Boolean   @default(true)     // Manual open/close toggle
  openingTime        String?   @default("08:00")  // HH:mm daily opening
  closingTime        String?   @default("23:00")  // HH:mm daily closing
  acceptsExpress     Boolean   @default(true)     // Accepts express/immediate delivery
  acceptsScheduled   Boolean   @default(true)     // Accepts scheduled delivery
  busyMode           Boolean   @default(false)    // High order volume / pause express
  closedReason       String?                      // Optional closure reason note
  cashOnDeliveryEnabled Boolean @default(true)    // Store-level COD enablement switch

  // Store geolocation — used for delivery distance calculation
  latitude           Float?
  longitude          Float?
  locationUpdatedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  products    Product[]
  addresses   Address[]
  enhancement StoreEnhancement?  // Responsive banners, multi-size logos, social counters
  campaignProducts CampaignProduct[]
  campaignSellers  CampaignSeller[]

  @@index([sellerId])
  @@index([slug])
}


// ==========================================
// 2. LOCATIONS & ADDRESSES
// ==========================================

model Country {
  id        String   @id @default(uuid())
  code      String   @unique // SA, AE, KW, etc.
  nameAr    String
  nameEn    String
  currency  String   @default("SAR")
  phoneCode String   @default("+966")
  isActive  Boolean  @default(true)

  cities    City[]
}

model City {
  id        String     @id @default(uuid())
  countryId String
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  nameAr    String
  nameEn    String
  latitude  Float?
  longitude Float?
  isActive  Boolean    @default(true)

  districts District[]
  addresses Address[]
  deliveryZones DeliveryZone[]

  @@index([countryId])
}

model District {
  id            String         @id @default(uuid())
  cityId        String
  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  nameAr        String
  nameEn        String
  latitude      Float?
  longitude     Float?
  isActive      Boolean        @default(true)

  neighborhoods Neighborhood[]
  addresses     Address[]

  @@index([cityId])
}

model Neighborhood {
  id         String    @id @default(uuid())
  districtId String
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  nameAr     String
  nameEn     String
  isActive   Boolean   @default(true)

  addresses  Address[]

  @@index([districtId])
}

model Address {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId        String?
  store          Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type           AddressType   @default(HOME)
  recipientName  String
  recipientPhone String
  street         String
  buildingNumber String?
  apartmentNumber String?
  floorNumber    String?
  postalCode     String?
  cityId         String
  city           City          @relation(fields: [cityId], references: [id])
  districtId     String?
  district       District?     @relation(fields: [districtId], references: [id])
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  latitude       Float?
  longitude      Float?
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders         Order[]

  @@index([userId])
  @@index([cityId])
}

// ==========================================
// 3. DELIVERY ENGINE
// ==========================================

model DeliveryZone {
  id          String           @id @default(uuid())
  name        String
  cityId      String?
  city        City?            @relation(fields: [cityId], references: [id])
  zoneType    DeliveryZoneType @default(CITY)
  radiusKm    Float?
  centerLat   Float?
  centerLng   Float?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  boundaries  DeliveryZoneBoundary[]
  rules       DeliveryRule[]

  @@index([cityId])
}

model DeliveryZoneBoundary {
  id        String       @id @default(uuid())
  zoneId    String
  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  order     Int
  latitude  Float
  longitude Float

  @@index([zoneId])
}

// Distance-based pricing zones — replaces flat-fee logic
// Each zone defines a km range and the fee for deliveries within it.
model DeliveryZonePricing {
  id               String   @id @default(uuid())
  name             String   // e.g. "Zone 1", "منطقة 1"
  nameAr           String   @default("")
  minDistanceKm    Float    // inclusive lower bound
  maxDistanceKm    Float?   // null = open-ended (>= minDistanceKm)
  baseFee          Float    // base delivery fee in currency
  extraFeePerKm    Float    @default(0.0) // extra fee per km beyond minDistanceKm (for open zones)
  currency         String   @default("YER")
  isActive         Boolean  @default(true)
  priority         Int      @default(0) // lower priority = checked first
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quoteSnapshots   DeliveryQuoteSnapshot[]

  @@index([isActive])
  @@index([priority])
}

// Immutable snapshot of the delivery fee at the time of checkout confirmation.
// Historical orders ALWAYS use this — never recalculate with current pricing.
model DeliveryQuoteSnapshot {
  id                    String                   @id @default(uuid())
  sellerOrderId         String                   @unique
  sellerOrder           SellerOrder              @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  zonePricingId         String?
  zonePricing           DeliveryZonePricing?     @relation(fields: [zonePricingId], references: [id])
  distanceKm            Float
  durationMinutes       Float?
  zoneName              String
  baseFee               Float
  extraSellerFee        Float                    @default(0.0)
  weightFee             Float                    @default(0.0)
  expressFee            Float                    @default(0.0)
  slotFee               Float                    @default(0.0)   // Time-slot surcharge at booking time
  deliveryDiscount      Float                    @default(0.0)
  discountFundedBy      DeliveryDiscountFundedBy?
  deliveryFee           Float                    // final amount customer pays
  currency              String                   @default("YER")
  pricingVersion        String                   // e.g. "2026-08-28-v1"
  isExpress             Boolean                  @default(false)
  // Scheduled delivery snapshot — immutable after order creation
  deliveryScheduleType  String?                  // "ASAP" | "SCHEDULED" | "EXPRESS"
  deliveryDate          DateTime?
  timeSlotId            String?
  timeSlotNameAr        String?
  timeSlotStart         String?                  // HH:mm
  timeSlotEnd           String?                  // HH:mm
  calculatedAt          DateTime                 @default(now())

  @@index([sellerOrderId])
  @@index([zonePricingId])
}

// System-wide delivery configuration controlled by Admin
model DeliverySettings {
  id                     String                    @id @default(uuid())
  multiVendorPolicy      MultiVendorDeliveryPolicy @default(PER_SELLER)
  expressEnabled         Boolean                   @default(true)
  expressFeeFixed        Float                     @default(500.0)
  maxDeliveryRadiusKm    Float                     @default(50.0)
  freeDeliveryThreshold  Float?                    // order value above which delivery is free
  currency               String                    @default("YER")
  // Scheduled delivery settings
  schedulingEnabled      Boolean                   @default(true)
  deliveryScheduleScope  DeliveryScheduleScope     @default(ORDER)
  schedulingAdvanceDays  Int                       @default(7)   // how many days ahead customers can schedule
  updatedAt              DateTime                  @updatedAt
}

// ── Scheduled Delivery ────────────────────────────────────────────────────────

// Admin-configurable delivery time windows (e.g. 10:00–12:00)
model DeliveryTimeSlot {
  id              String                  @id @default(uuid())
  nameAr          String                  // e.g. "الصباح"
  nameEn          String                  // e.g. "Morning"
  startTime       String                  // HH:mm  (24-h)
  endTime         String                  // HH:mm  (24-h)
  slotFee         Float                   @default(0.0)
  maxOrdersPerDay Int                     @default(50)
  isActive        Boolean                 @default(true)
  priority        Int                     @default(0)  // lower = shown first
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  rules           DeliveryScheduleRule[]
  bookings        DeliverySlotBooking[]
  orders          Order[]

  @@index([isActive])
  @@index([priority])
}

// Controls on which days of the week a slot is active and minimum advance booking time
model DeliveryScheduleRule {
  id              String           @id @default(uuid())
  timeSlotId      String
  timeSlot        DeliveryTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  dayOfWeek       Int?             // 0=Sun, 1=Mon … 6=Sat; null = every day
  minAdvanceHours Float            @default(1.0) // slot must start at least N hours from now
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([timeSlotId])
}

// One row per order-slot booking. Used for atomic capacity management.
model DeliverySlotBooking {
  id            String           @id @default(uuid())
  orderId       String           @unique
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  timeSlotId    String
  timeSlot      DeliveryTimeSlot @relation(fields: [timeSlotId], references: [id])
  deliveryDate  DateTime         // date only (time part ignored)
  createdAt     DateTime         @default(now())

  @@unique([timeSlotId, deliveryDate, orderId])
  @@index([timeSlotId, deliveryDate])
}

model DeliveryMethod {
  id               String                  @id @default(uuid())
  code             String                  @unique // standard, express, same_day, pickup
  nameAr           String
  nameEn           String
  description      String?
  basePrice        Float                   @default(15.0)
  calculationType  DeliveryCalculationType @default(FLAT)
  estimatedHoursMin Int                    @default(24)
  estimatedHoursMax Int                    @default(72)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())

  rules            DeliveryRule[]
  orders           Order[]
  sellerOrders     SellerOrder[]
}

model DeliveryRule {
  id                    String         @id @default(uuid())
  deliveryMethodId      String
  deliveryMethod        DeliveryMethod @relation(fields: [deliveryMethodId], references: [id], onDelete: Cascade)
  deliveryZoneId        String?
  deliveryZone          DeliveryZone?  @relation(fields: [deliveryZoneId], references: [id])
  fee                   Float          @default(15.0)
  freeDeliveryThreshold Float?
  pricePerKm            Float?
  pricePerKg            Float?
  isActive              Boolean        @default(true)

  @@index([deliveryMethodId])
  @@index([deliveryZoneId])
}

model DeliveryOrder {
  id             String      @id @default(uuid())
  sellerOrderId  String      @unique
  sellerOrder    SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  trackingNumber String      @unique
  carrierName    String?
  driverName     String?
  driverPhone    String?
  status         String      @default("ASSIGNED")
  pickupTime     DateTime?
  deliveryTime   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ==========================================
// 4. CATALOG (CATEGORIES, BRANDS, PRODUCTS)
// ==========================================

model Category {
  id          String     @id @default(uuid())
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  nameAr      String
  nameEn      String
  slug        String     @unique
  icon        String?
  image       String?
  sortOrder   Int        @default(0)
  commissionRate Float?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products          Product[]
  voucherCategories VoucherCategory[]
  recommendationEvents RecommendationEvent[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id        String    @id @default(uuid())
  nameAr    String
  nameEn    String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]

  @@index([slug])
}

model Product {
  id             String             @id @default(uuid())
  storeId        String
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category           @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?             @relation(fields: [brandId], references: [id])
  nameAr         String
  nameEn         String
  slug           String             @unique
  descriptionAr  String?
  descriptionEn  String?
  price          Float
  compareAtPrice Float?
  commissionRate Float?
  currency       String             @default("SAR")
  sku            String?            @unique
  barcode        String?
  rating         Float              @default(0.0)
  reviewCount    Int                @default(0)
  soldCount      Int                @default(0)
  isFeatured     Boolean            @default(false)
  isActive       Boolean            @default(true)
  isSuspended    Boolean            @default(false)
  weight         Float?
  hasWarranty    Boolean            @default(false)
  warrantyPeriod String?
  warrantyPolicy String?
  videoUrl       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  variants        ProductVariant[]
  images          ProductImage[]
  attributes      ProductAttribute[]
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  productReviews  ProductReview[]
  ratingSummary   ProductRatingSummary?
  flashSaleItems  FlashSaleProduct[]
  reports         ProductReport[]
  campaignItems       FlashSaleItem[]
  campaignSubmissions FlashSaleSellerSubmission[]
  voucherProducts     VoucherProduct[]
  campaignProducts    CampaignProduct[]
  refundRequestItems  RefundRequestItem[]
  recommendationEvents RecommendationEvent[]
  productFeature       ProductFeature?
  similarProducts      ProductSimilarity[]   @relation("ProductSimilaritySource")
  similarToProducts    ProductSimilarity[]   @relation("ProductSimilarityTarget")
  associations         ProductAssociation[]  @relation("ProductAssociationSource")
  associatedWith       ProductAssociation[]  @relation("ProductAssociationTarget")

  @@index([storeId])
  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([isActive])
  @@index([brandId])
  @@index([price])
  @@index([soldCount(sort: Desc)])
  @@index([isActive, soldCount(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([categoryId, isActive, createdAt(sort: Desc)])
  @@index([storeId, isActive, createdAt(sort: Desc)])
  @@index([isActive, isFeatured, soldCount(sort: Desc)])
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameAr         String
  nameEn         String
  sku            String?     @unique
  price          Float
  compareAtPrice Float?
  stockQuantity  Int         @default(0)
  image          String?
  createdAt      DateTime    @default(now())

  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  campaignItems       FlashSaleItem[]
  campaignSubmissions FlashSaleSellerSubmission[]
  voucherProducts     VoucherProduct[]
  campaignProducts    CampaignProduct[]
  refundRequestItems  RefundRequestItem[]

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)

  @@index([productId])
  @@index([productId, isPrimary])
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  keyAr     String
  keyEn     String
  valueAr   String
  valueEn   String

  @@index([productId])
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int      @default(0)
  lowStockAlert  Int      @default(5)
  reserved       Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model ProductReport {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason      String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([status])
}

// ==========================================
// 5. CART
// ==========================================

model Cart {
  id         String     @id @default(uuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode      String?
  appliedVouchers String?
  createdAt       DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items      CartItem[]
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int             @default(1)
  isFlashSale Boolean        @default(false)
  flashSaleItemId String?
  flashSaleReservationId String?
  flashSaleUnitPrice Float?
  reservationExpiresAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([flashSaleItemId])
  @@index([flashSaleReservationId])
}

// ==========================================
// 6. ORDERS & CHECKOUT
// ==========================================

model Order {
  id                   String                 @id @default(uuid())
  orderNumber          String                 @unique
  orderSequence        Int?                   @unique
  displayOrderNumber   String?
  idempotencyKey       String?                @unique
  userId               String
  user                 User                   @relation(fields: [userId], references: [id])
  deliveryAddressId    String?
  deliveryAddress      Address?               @relation(fields: [deliveryAddressId], references: [id])
  deliveryMethodId     String?
  deliveryMethod       DeliveryMethod?        @relation(fields: [deliveryMethodId], references: [id])
  status               OrderStatus            @default(PENDING)
  currency             String                 @default("SAR")
  subtotal             Float
  deliveryFee          Float                  @default(0.0)
  discountAmount       Float                  @default(0.0)
  taxAmount            Float                  @default(0.0)
  total                Float
  couponCode           String?
  notes                String?
  // Voucher fields
  voucherId            String?
  voucherCode          String?
  platformDiscount     Float                  @default(0.0)
  sellerDiscount       Float                  @default(0.0)
  shippingDiscount     Float                  @default(0.0)
  platformFunding      Float                  @default(0.0)
  sellerFunding        Float                  @default(0.0)
  // First-order free shipping snapshot
  originalShippingAmount      Float?                 @default(0.0)
  shippingPromotionDiscount    Float?                 @default(0.0)
  customerShippingCharge       Float?                 @default(0.0)
  platformShippingSubsidy      Float?                 @default(0.0)
  sellerShippingContribution   Float?                 @default(0.0)
  sellerDeliveryReimbursement  Float?                 @default(0.0)
  shippingCostBearer           String?
  shippingPromotionId          String?
  shippingPromotionType        String?
  shippingPromotionName        String?
  shippingPromotionAppliedAt   DateTime?
  // Scheduled delivery fields
  deliveryScheduleType DeliveryScheduleType   @default(ASAP)
  deliveryDate         DateTime?              // customer-requested delivery date
  deliveryTimeSlotId   String?
  deliveryTimeSlot     DeliveryTimeSlot?      @relation(fields: [deliveryTimeSlotId], references: [id])
  deliveredAt          DateTime?              // Server-authoritative delivery timestamp for 14-day refund window
  // SOUQNAA Coins Snapshot (§82)
  coinsUsed            Int                    @default(0)
  coinDiscount         Float                  @default(0.0)
  coinConversionRate   Float                  @default(100.0)
  rewardPolicyVersion  String?
  coinCampaignId       String?
  coinTransactionId    String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  sellerOrders         SellerOrder[]
  statusHistory        OrderStatusHistory[]
  cancellationRequests CancellationRequest[]
  returnRequests       ReturnRequest[]
  addressSnapshot      OrderDeliveryAddress?
  payment              Payment?
  slotBooking          DeliverySlotBooking?
  voucherRedemptions   VoucherRedemption[]
  refundRequests       RefundRequest[]
  financialTransactions FinancialTransaction[]
  coinReservations     CoinReservation[]
  taxSnapshots         OrderTaxSnapshot[]
  refundTaxRecords     RefundTaxRecord[]
  promotionUsages      PromotionUsage[]
  promotionReservations PromotionReservation[]

  @@index([userId])
  @@index([orderNumber])
  @@index([orderSequence])
  @@index([idempotencyKey])
  @@index([status])
  @@index([deliveryTimeSlotId])
  @@index([deliveryMethodId])
  @@index([deliveredAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}


model SellerOrder {
  id                   String                 @id @default(uuid())
  orderId              String
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId             String
  seller               Seller                 @relation(fields: [sellerId], references: [id])
  sellerOrderNumber    String?                @unique
  subOrderIndex        Int?
  deliveryMethodId     String?
  deliveryMethod       DeliveryMethod?        @relation(fields: [deliveryMethodId], references: [id])
  status               SellerOrderStatus      @default(PENDING)
  subtotal             Float
  deliveryFee          Float                  @default(0.0)
  taxAmount            Float                  @default(0.0)
  commissionAmount      Float                  @default(0.0)
  sellerPayout          Float
  voucherDiscountAmount Float                  @default(0.0)
  sellerFundedDiscount  Float                  @default(0.0)
  platformFundedDiscount Float                 @default(0.0)
  // Free Shipping Delivery Breakdown
  originalDeliveryFee          Float?                 @default(0.0)
  shippingPromotionDiscount    Float?                 @default(0.0)
  customerDeliveryCharge       Float?                 @default(0.0)
  platformShippingSubsidy      Float?                 @default(0.0)
  sellerShippingContribution   Float?                 @default(0.0)
  sellerDeliveryReimbursement  Float?                 @default(0.0)
  shippingCostBearer           String?
  // Delivery distance snapshot for this seller sub-order
  distanceKm           Float?
  durationMinutes      Float?
  deliveryZoneName     String?
  deliveredAt          DateTime?              // Server-authoritative delivery timestamp
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  cancellationRequests CancellationRequest[]
  returnRequests       ReturnRequest[]
  deliveryOrder        DeliveryOrder?
  deliveryQuoteSnapshot DeliveryQuoteSnapshot?
  refundRequests       RefundRequest[]

  printCount           Int                    @default(0)
  lastPrintedAt        DateTime?
  printLogs            SellerOrderPrintLog[]
  taxSnapshots         OrderTaxSnapshot[]
  settlementItems      SettlementItem[]

  @@index([orderId])
  @@index([sellerId])
  @@index([sellerOrderNumber])
  @@index([status])
  @@index([deliveredAt])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([sellerId, status])
  @@index([status, createdAt(sort: Desc)])
}

model SellerOrderPrintLog {
  id            String      @id @default(uuid())
  sellerId      String
  orderId       String
  sellerOrderId String
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  documentType  String      // INVOICE, PACKING_SLIP, STATEMENT
  format        String      // A4, 80MM, 58MM
  printedBy     String?
  printedAt     DateTime    @default(now())

  @@index([sellerId])
  @@index([sellerOrderId])
  @@index([orderId])
}

model OrderCounter {
  name      String   @id @default("order_number")
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id            String          @id @default(uuid())
  sellerOrderId String
  sellerOrder   SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  productNameAr String
  productNameEn String
  unitPrice     Float
  quantity      Int
  totalPrice    Float
  taxAmount     Float                  @default(0.0)
  isFlashSale   Boolean         @default(false)
  campaignId    String?
  flashSaleItemId String?
  originalPrice Float?
  flashSalePrice Float?
  discountType  String?
  discountValue Float?
  discountAmount Float?
  allocatedStock             Int?
  voucherDiscountAmount      Float                  @default(0.0)
  createdAt                  DateTime               @default(now())

  productReviews             ProductReview[]
  voucherDiscountAllocations VoucherDiscountAllocation[]
  refundRequestItems         RefundRequestItem[]
  taxSnapshots               OrderTaxSnapshot[]

  @@index([sellerOrderId])
  @@index([productId])
  @@index([variantId])
  @@index([flashSaleItemId])
  @@index([productId, createdAt(sort: Desc)])
}

model OrderStatusHistory {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId String?
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  fromStatus    String?
  toStatus      String       @default("PENDING")
  status        OrderStatus  @default(PENDING)
  changedBy     String?
  changedByRole String?      // 'CUSTOMER', 'SELLER', 'ADMIN', 'SYSTEM'
  reason        String?
  metadata      String?      // JSON data
  note          String?
  createdAt     DateTime     @default(now())

  @@index([orderId])
  @@index([sellerOrderId])
}

model CancellationRequest {
  id              String                    @id @default(uuid())
  orderId         String
  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId   String?
  sellerOrder     SellerOrder?              @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  requestedBy     String                    // userId
  requestedByRole String                    // 'CUSTOMER', 'SELLER', 'ADMIN'
  reason          String                    // CancellationReason enum string
  description     String?
  status          CancellationRequestStatus @default(PENDING)
  resolvedBy      String?                   // userId
  resolvedAt      DateTime?
  adminNote       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([status])
}

model ReturnRequest {
  id            String              @id @default(uuid())
  orderId       String
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId String?
  sellerOrder   SellerOrder?        @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  customerId    String              // userId
  reason        String
  description   String?
  status        ReturnRequestStatus @default(PENDING)
  refundAmount  Float?
  resolvedBy    String?             // userId
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([status])
}

model OrderDeliveryAddress {
  id             String  @id @default(uuid())
  orderId        String  @unique
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipientName  String
  recipientPhone String
  street         String
  buildingNumber String?
  apartmentNumber String?
  cityName       String
  districtName   String?
  latitude       Float?
  longitude      Float?
}

// ==========================================
// 7. PAYMENTS
// ==========================================

model Payment {
  id            String               @id @default(uuid())
  orderId       String               @unique
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethodType    @default(CASH_ON_DELIVERY)
  status        PaymentStatus        @default(PENDING)
  amount        Float
  currency      String               @default("SAR")
  transactionId        String?
  paidAt               DateTime?
  walletProvider       String?              // KURAIMI, CASHPAY, ONECASH, JAWALI, JAIB, YEMEN_WALLET
  walletSenderNumber   String?              // Sender's wallet account or phone number
  walletTransactionRef String?              // External reference/operation ID
  walletReceiptUrl     String?              // Proof of transfer image URL
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  transactions  PaymentTransaction[]

  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([walletTransactionRef])
}

model PaymentTransaction {
  id          String        @id @default(uuid())
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  gateway     String        // e.g. Mada, ApplePay, Stripe, HyperPay, Cash
  referenceId String?
  amount      Float
  status      PaymentStatus
  rawResponse String?       // JSON response from payment gateway
  createdAt   DateTime      @default(now())

  @@index([paymentId])
}

// ==========================================
// 8. PROMOTIONS, COUPONS & FLASH SALES
// ==========================================

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float?
  maxDiscount   Float?
  usageLimit    Int?
  usageCount    Int          @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([code])
}

// ==========================================
// 8A. SHOPEE-STYLE VOUCHERS (PHASE 39)
// ==========================================

model Voucher {
  id                      String              @id @default(uuid())
  code                    String
  normalizedCode          String              @unique
  name                    String
  description             String?

  ownerType               VoucherOwnerType    @default(PLATFORM)
  ownerId                 String?

  voucherType             VoucherType         @default(DISCOUNT)
  discountType            VoucherDiscountType @default(PERCENTAGE)
  discountValue           Float
  maximumDiscount         Float?

  minimumOrderAmount      Float?              @default(0.0)
  minimumEligibleAmount   Float?              @default(0.0)

  currency                String              @default("SAR")

  scopeType               VoucherScopeType    @default(PLATFORM)

  isClaimable             Boolean             @default(true)
  isAutoApply             Boolean             @default(false)
  isStackable             Boolean             @default(false)

  priority                Int                 @default(0)

  usageLimit              Int?
  usageCount              Int                 @default(0)

  claimLimit              Int?
  claimCount              Int                 @default(0)

  perCustomerClaimLimit   Int                 @default(1)
  perCustomerUsageLimit   Int                 @default(1)

  startAt                 DateTime
  endAt                   DateTime

  status                  VoucherStatus       @default(ACTIVE)

  firstOrderOnly          Boolean             @default(false)
  newCustomerOnly         Boolean             @default(false)

  sellerId                String?
  fundingType             VoucherFundingType  @default(PLATFORM)

  freeShipping            Boolean             @default(false)
  maximumShippingDiscount Float?

  createdBy               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  customerVouchers        CustomerVoucher[]
  products                VoucherProduct[]
  categories              VoucherCategory[]
  redemptions             VoucherRedemption[]
  discountAllocations     VoucherDiscountAllocation[]
  reservations            VoucherReservation[]

  seller                  Seller?             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([normalizedCode])
  @@index([ownerType, ownerId])
  @@index([status, startAt, endAt])
  @@index([sellerId])
  @@index([scopeType])
  @@index([voucherType])
}

model CustomerVoucher {
  id          String                @id @default(uuid())
  customerId  String
  customer    User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  voucherId   String
  voucher     Voucher               @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  status      CustomerVoucherStatus @default(CLAIMED)
  claimedAt   DateTime              @default(now())
  usedAt      DateTime?
  expiresAt   DateTime?
  usageCount  Int                   @default(0)
  claimSource String?               // VOUCHER_CENTER, PRODUCT_PAGE, STORE_PAGE, CAMPAIGN, ADMIN_ISSUED
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([customerId, voucherId])
  @@index([customerId, status])
  @@index([voucherId])
}

model VoucherProduct {
  id        String          @id @default(uuid())
  voucherId String
  voucher   Voucher         @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([voucherId, productId, variantId])
  @@index([voucherId])
  @@index([productId])
}

model VoucherCategory {
  id                 String   @id @default(uuid())
  voucherId          String
  voucher            Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  includeDescendants Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@unique([voucherId, categoryId])
  @@index([voucherId])
  @@index([categoryId])
}

model VoucherReservation {
  id         String                   @id @default(uuid())
  voucherId  String
  voucher    Voucher                  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  customerId String
  customer   User                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  checkoutId String?
  cartId     String?
  status     VoucherReservationStatus @default(RESERVED)
  expiresAt  DateTime
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([voucherId, status])
  @@index([customerId, status])
  @@index([expiresAt])
}

model VoucherRedemption {
  id             String             @id @default(uuid())
  voucherId      String
  voucher        Voucher            @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  customerId     String
  customer       User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId        String
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId       String?
  seller         Seller?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  discountAmount Float
  fundingType    VoucherFundingType
  eligibleAmount Float
  currency       String             @default("SAR")
  idempotencyKey String?
  redeemedAt     DateTime           @default(now())

  @@index([voucherId])
  @@index([customerId])
  @@index([orderId])
  @@index([sellerId])
  @@index([idempotencyKey])
}

model VoucherDiscountAllocation {
  id             String             @id @default(uuid())
  voucherId      String
  voucher        Voucher            @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  cartItemId     String?
  orderItemId    String?
  orderItem      OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sellerId       String?
  productId      String?
  discountAmount Float
  fundingType    VoucherFundingType
  createdAt      DateTime           @default(now())

  @@index([voucherId])
  @@index([orderItemId])
  @@index([sellerId])
  @@index([productId])
}


model Promotion {
  id          String    @id @default(uuid())
  titleAr     String
  titleEn     String
  bannerImage String?
  targetUrl   String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ==========================================
// 8C. FIRST-ORDER FREE SHIPPING ENGINE
// ==========================================

model FirstOrderFreeShippingConfig {
  id                          String                      @id @default(uuid())
  enabled                     Boolean                     @default(true)
  minOrderAmount              Float                       @default(0.0)
  maxDiscount                 Float?
  costBearer                  ShippingPromotionCostBearer @default(PLATFORM)
  platformSubsidyLimit        Float?
  sellerContributionLimit     Float?
  sharedPlatformPercentage    Float?                      @default(70.0)
  allowedDeliveryMethods      String[]                    @default(["standard", "asap", "scheduled"])
  allowedZones                String[]                    @default([])
  allowedSellers              String[]                    @default([])
  startAt                     DateTime?
  endAt                       DateTime?
  usageLimit                  Int?
  customerLimit               Int                         @default(1)
  platformBudget              Float?
  consumedBudget              Float                       @default(0.0)
  requireVerifiedPhone        Boolean                     @default(false)
  requireVerifiedEmail        Boolean                     @default(false)
  abuseProtectionEnabled      Boolean                     @default(true)
  eligibleOrderStatuses       String[]                    @default(["CONFIRMED", "PROCESSING", "READY_TO_SHIP", "SHIPPED", "DELIVERED"])
  version                     Int                         @default(1)
  updatedBy                   String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
}

model PromotionReservation {
  id                          String                      @id @default(uuid())
  customerId                  String
  customer                    User                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  promotionType               String                      @default("FIRST_ORDER_FREE_SHIPPING")
  shippingPromotionId         String?
  shippingPromotion           ShippingPromotion?          @relation(fields: [shippingPromotionId], references: [id], onDelete: SetNull)
  orderId                     String?
  order                       Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cartId                      String?
  checkoutId                  String?
  status                      PromotionReservationStatus  @default(RESERVED)
  originalShippingAmount      Float                       @default(0.0)
  discountAmount              Float                       @default(0.0)
  platformSubsidy             Float                       @default(0.0)
  sellerContribution          Float                       @default(0.0)
  costBearer                  ShippingPromotionCostBearer @default(PLATFORM)
  reservedAt                  DateTime                    @default(now())
  expiresAt                   DateTime
  releasedAt                  DateTime?
  consumedAt                  DateTime?
  idempotencyKey              String?                     @unique
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  usages                      PromotionUsage[]

  @@index([customerId, promotionType, status])
  @@index([shippingPromotionId])
  @@index([orderId])
  @@index([expiresAt])
}

model PromotionUsage {
  id                          String                      @id @default(uuid())
  customerId                  String
  customer                    User                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  promotionType               String                      @default("FIRST_ORDER_FREE_SHIPPING")
  shippingPromotionId         String?
  shippingPromotion           ShippingPromotion?          @relation(fields: [shippingPromotionId], references: [id], onDelete: SetNull)
  orderId                     String
  order                       Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservationId               String?
  reservation                 PromotionReservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  costBearer                  ShippingPromotionCostBearer @default(PLATFORM)
  originalShippingAmount      Float                       @default(0.0)
  discountAmount              Float                       @default(0.0)
  platformSubsidy             Float                       @default(0.0)
  sellerContribution          Float                       @default(0.0)
  sellerDeliveryReimbursement Float                       @default(0.0)
  status                      String                      @default("CONSUMED")
  consumedAt                  DateTime                    @default(now())
  restoredAt                  DateTime?
  restoredBy                  String?
  restorationReason           String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@index([customerId, promotionType])
  @@index([shippingPromotionId])
  @@index([orderId])
  @@index([status])
}

model PromotionEligibilityAudit {
  id             String                      @id @default(uuid())
  customerId     String
  customer       User                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  promotionType  String                      @default("FIRST_ORDER_FREE_SHIPPING")
  status         FirstOrderEligibilityStatus
  reason         String?
  signals        String?
  cartTotal      Float?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime                    @default(now())

  @@index([customerId, promotionType])
  @@index([createdAt])
}

model PromotionConfigAuditLog {
  id             String                      @id @default(uuid())
  actorId        String
  actor          User                        @relation(fields: [actorId], references: [id])
  promotionType  String                      @default("FIRST_ORDER_FREE_SHIPPING")
  action         String
  reason         String
  previousValue  String
  newValue       String
  createdAt      DateTime                    @default(now())

  @@index([actorId])
  @@index([promotionType])
  @@index([createdAt])
}

// ==========================================
// 8D. UNIVERSAL SHIPPING PROMOTIONS SYSTEM
// ==========================================

model ShippingPromotion {
  id                          String                          @id @default(uuid())
  code                        String                          @unique
  name                        String
  nameAr                      String?
  description                 String?
  descriptionAr               String?

  type                        ShippingPromotionType           @default(FIRST_ORDER)
  fundingType                 ShippingFundingType             @default(PLATFORM)
  status                      ShippingPromotionStatus         @default(ACTIVE)
  priority                    Int                             @default(0)

  startAt                     DateTime?
  endAt                       DateTime?

  minimumOrderAmount          Float                           @default(0.0)
  maximumDiscountAmount       Float?                          // null = full original delivery fee covered

  percentageDiscount          Float?                          @default(100.0) // 100% = full free shipping
  fixedDiscount               Float?                          // fixed discount amount if not percentage

  customerEligibilityRules    Json?                           @default("{}")
  sellerEligibilityRules      Json?                           @default("{}")
  orderEligibilityRules       Json?                           @default("{}")
  deliveryEligibilityRules    Json?                           @default("{}")
  locationEligibilityRules    Json?                           @default("{}")

  allowedDeliveryMethods      String[]                        @default(["standard", "asap", "scheduled"])
  allowedZones                String[]                        @default([])
  allowedSellers              String[]                        @default([])
  allowedProducts             String[]                        @default([])
  allowedCategories           String[]                        @default([])

  platformSubsidyRate         Float?                          @default(70.0)
  sellerContributionRate      Float?                          @default(30.0)
  platformSubsidyLimit        Float?
  sellerContributionLimit     Float?

  customerUsageLimit          Int?                            @default(1)
  sellerUsageLimit            Int?
  globalUsageLimit            Int?
  currentUsageCount           Int                             @default(0)

  campaignId                  String?
  campaign                    Campaign?                       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  campaignBudget              Float?
  consumedBudget              Float                           @default(0.0)
  remainingBudget             Float?

  requiresVerifiedPhone       Boolean                         @default(false)
  requiresVerifiedEmail       Boolean                         @default(false)
  abuseProtectionEnabled      Boolean                         @default(true)

  stackingPolicy              ShippingPromotionStackingPolicy @default(BEST_SHIPPING_PROMOTION)
  reservationRequired         Boolean                         @default(true)

  createdBy                   String?
  updatedBy                   String?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt

  reservations                PromotionReservation[]
  usages                      PromotionUsage[]
  budgetTransactions          ShippingPromotionBudgetTransaction[]
  auditLogs                   ShippingPromotionAuditLog[]

  @@index([status, type])
  @@index([campaignId])
  @@index([code])
  @@index([startAt, endAt])
}

model ShippingPromotionBudgetTransaction {
  id                          String                @id @default(uuid())
  promotionId                 String
  promotion                   ShippingPromotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId                     String?
  reservationId               String?
  amount                      Float
  type                        String                // RESERVATION, CONSUMPTION, RELEASE, RESTORATION, MANUAL_ADJUSTMENT
  balanceBefore               Float
  balanceAfter                Float
  reference                   String?
  createdAt                   DateTime              @default(now())

  @@index([promotionId])
  @@index([orderId])
  @@index([createdAt])
}

model ShippingPromotionAuditLog {
  id                          String                @id @default(uuid())
  promotionId                 String?
  promotion                   ShippingPromotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  actorId                     String
  actor                       User                  @relation("ShippingPromotionAuditActor", fields: [actorId], references: [id])
  action                      String
  previousValue               String?
  newValue                    String?
  reason                      String?
  createdAt                   DateTime              @default(now())

  @@index([promotionId])
  @@index([actorId])
  @@index([createdAt])
}

model FlashSale {
  id          String             @id @default(uuid())
  titleAr     String
  titleEn     String
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())

  products    FlashSaleProduct[]
}

model FlashSaleProduct {
  id             String    @id @default(uuid())
  flashSaleId    String
  flashSale      FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPrice  Float
  discountPercent Float
  limitPerUser   Int       @default(1)
  soldQuantity   Int       @default(0)

  @@index([flashSaleId])
  @@index([productId])
}

// ==========================================
// 8B. FLASH SALES ENGINE (PHASE 40)
// ==========================================

model FlashSaleCampaign {
  id                      String                @id @default(uuid())
  name                    String
  slug                    String                @unique
  description             String?
  bannerImage             String?
  mobileBanner            String?
  desktopBanner           String?
  campaignColor           String?
  campaignBadge           String?
  status                  FlashSaleStatus       @default(DRAFT)
  startAt                 DateTime
  endAt                   DateTime
  timezone                String                @default("UTC")
  priority                Int                   @default(0)
  displayOrder            Int                   @default(0)
  maxProducts             Int?
  isFeatured              Boolean               @default(false)
  customerEligibility     String?               @default("ALL")
  minimumAppVersion       String?
  termsAndConditions      String?
  couponPolicy            FlashSaleCouponPolicy @default(ALLOW_COUPONS)
  allowedCustomerSegments String?
  allowedCountries        String?
  allowedCities           String?
  minimumOrderAmount      Float?
  maximumOrders           Int?
  publishedAt             DateTime?
  cancelledAt             DateTime?
  createdBy               String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  items                   FlashSaleItem[]
  submissions             FlashSaleSellerSubmission[]
  reservations            FlashSaleReservation[]

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([priority])
  @@index([isFeatured])
}

model FlashSaleItem {
  id                      String                @id @default(uuid())
  campaignId              String
  campaign                FlashSaleCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sellerId                String
  seller                  Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId               String?
  variant                 ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  skuId                   String?
  originalPrice           Float
  flashSalePrice          Float
  discountType            FlashSaleDiscountType @default(PERCENTAGE)
  discountValue           Float
  maximumDiscount         Float?
  allocatedStock          Int
  reservedStock           Int                   @default(0)
  soldStock               Int                   @default(0)
  remainingStock          Int                   @default(0)
  perCustomerLimit        Int                   @default(1)
  minimumPurchaseQuantity Int                   @default(1)
  maximumPurchaseQuantity Int?
  status                  FlashSaleItemStatus   @default(ACTIVE)
  sellerProposedPrice     Float?
  sellerProposedStock     Int?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  reservations            FlashSaleReservation[]

  @@unique([campaignId, productId, variantId])
  @@index([campaignId])
  @@index([sellerId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
}

model FlashSaleSellerSubmission {
  id                    String                    @id @default(uuid())
  campaignId            String
  campaign              FlashSaleCampaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sellerId              String
  seller                Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId             String
  product               Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId             String?
  variant               ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  proposedPrice         Float
  proposedStock         Int
  proposedPurchaseLimit Int                       @default(1)
  notes                 String?
  status                FlashSaleSubmissionStatus @default(PENDING_REVIEW)
  rejectionReason       String?
  reviewedBy            String?
  reviewedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([campaignId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
}

model FlashSaleReservation {
  id              String                     @id @default(uuid())
  flashSaleItemId String
  flashSaleItem   FlashSaleItem              @relation(fields: [flashSaleItemId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        FlashSaleCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User                       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cartId          String?
  checkoutId      String?
  orderId         String?
  quantity        Int
  unitPrice       Float
  totalAmount     Float
  status          FlashSaleReservationStatus @default(RESERVED)
  idempotencyKey  String?                    @unique
  expiresAt       DateTime
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([flashSaleItemId])
  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@index([orderId])
}

model Banner {
  id          String   @id @default(uuid())
  titleAr     String?
  titleEn     String?
  imageUrl    String
  targetType  String?  // 'product', 'category', 'store', 'url'
  targetId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ==========================================
// 9. WISHLIST, REVIEWS & CHAT
// ==========================================

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  items     WishlistItem[]
}

model WishlistItem {
  id                      String          @id @default(uuid())
  wishlistId              String
  wishlist                Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId               String?
  variant                 ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  addedPrice              Float           @default(0.0)
  currentPrice            Float           @default(0.0)
  priceCurrency           String          @default("SAR")
  priceDropAlertEnabled   Boolean         @default(true)
  backInStockAlertEnabled Boolean         @default(true)
  lastNotifiedPrice       Float?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt

  alerts                  WishlistAlert[]

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model WishlistAlert {
  id             String              @id @default(uuid())
  wishlistItemId String
  wishlistItem   WishlistItem        @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertType      WishlistAlertType
  oldPrice       Float?
  newPrice       Float?
  currency       String              @default("SAR")
  threshold      Float?
  status         WishlistAlertStatus @default(PENDING)
  triggeredAt    DateTime            @default(now())
  notifiedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId, status])
  @@index([wishlistItemId, alertType])
  @@index([triggeredAt])
}

// ==========================================
// REVIEWS & RATINGS SYSTEM
// ==========================================

model ProductReview {
  id                  String       @id @default(uuid())
  // Relationships
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String
  product             Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId            String       // denormalized from product.store.sellerId for fast filtering
  orderId             String
  sellerOrderId       String
  orderItemId         String
  orderItem           OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Core content
  rating              Int          // 1–5, validated server-side
  title               String?
  body                String?
  locale              String?      @default("ar") // 'ar' or 'en'

  // Status & flags
  status              ReviewStatus @default(PENDING)
  verifiedPurchase    Boolean      @default(false)
  helpfulCount        Int          @default(0)
  reportCount         Int          @default(0)
  sellerResponseExists Boolean     @default(false)

  // Timestamps
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  publishedAt         DateTime?
  deletedAt           DateTime?    // soft-delete

  // Relations
  media               ReviewMedia[]
  sellerResponse      ReviewSellerResponse?
  helpfulVotes        ReviewHelpfulVote[]
  reports             ReviewReport[]
  moderationHistory   ReviewModerationHistory[]

  @@unique([userId, orderItemId])  // One review per purchase
  @@index([productId, status, createdAt])
  @@index([productId, rating, status])
  @@index([userId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([orderItemId])
}

model ReviewMedia {
  id                  String                        @id @default(uuid())
  reviewId            String
  review              ProductReview                 @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaType           ReviewMediaType
  storageKey          String
  url                 String
  thumbnailKey        String?
  thumbnailUrl        String?
  mimeType            String
  fileSize            Int                           @default(0)
  width               Int?
  height              Int?
  durationSeconds     Float?
  processingStatus    ReviewMediaProcessingStatus   @default(READY)
  moderationStatus    ReviewMediaModerationStatus   @default(APPROVED)
  sortOrder           Int                           @default(0)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([reviewId])
  @@index([mediaType, moderationStatus])
}

model ReviewSellerResponse {
  id        String                      @id @default(uuid())
  reviewId  String                      @unique
  review    ProductReview               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller                      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  body      String
  status    ReviewSellerResponseStatus  @default(PUBLISHED)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  moderationHistory ReviewModerationHistory[]

  @@index([reviewId])
  @@index([sellerId])
}

model ReviewHelpfulVote {
  id        String                @id @default(uuid())
  reviewId  String
  review    ProductReview         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      ReviewHelpfulVoteType
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model ReviewReport {
  id          String              @id @default(uuid())
  reviewId    String
  review      ProductReview       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User                @relation("ReviewReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason      ReviewReportReason
  description String?
  status      ReviewReportStatus  @default(PENDING)
  resolvedBy  String?             // userId of admin
  resolvedAt  DateTime?
  adminNote   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([reviewId, reporterId])  // one report per reviewer
  @@index([reviewId, status])
  @@index([status, createdAt])
}

model ReviewModerationHistory {
  id               String                @id @default(uuid())
  reviewId         String?
  review           ProductReview?        @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  sellerResponseId String?
  sellerResponse   ReviewSellerResponse? @relation(fields: [sellerResponseId], references: [id], onDelete: SetNull)
  adminUserId      String?               // userId of admin actor
  previousStatus   String?
  newStatus        String
  reason           String?
  createdAt        DateTime              @default(now())

  @@index([reviewId])
  @@index([sellerResponseId])
}

model ProductRatingSummary {
  id                  String   @id @default(uuid())
  productId           String   @unique
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  averageRating       Float    @default(0.0)
  ratingCount         Int      @default(0)
  oneStarCount        Int      @default(0)
  twoStarCount        Int      @default(0)
  threeStarCount      Int      @default(0)
  fourStarCount       Int      @default(0)
  fiveStarCount       Int      @default(0)
  reviewCount         Int      @default(0)  // reviews with written body
  photoReviewCount    Int      @default(0)
  videoReviewCount    Int      @default(0)
  verifiedReviewCount Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@index([productId])
}

model Conversation {
  id           String               @id @default(uuid())
  title        String?
  status       String               @default("ACTIVE") // ACTIVE, ARCHIVED, BLOCKED
  type         String               @default("DIRECT_CUSTOMER_SELLER") // DIRECT_CUSTOMER_SELLER, SUPPORT_CUSTOMER, SUPPORT_SELLER, OPTIONAL_INTERNAL_ADMIN
  lastMessageId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  members      ConversationMember[]
  messages     Message[]
  supportConversation SupportConversation?
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  muted          Boolean      @default(false)
  blocked        Boolean      @default(false)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id              String         @id @default(uuid())
  conversationId  String
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  type            String         @default("text") // 'text', 'image', 'file', 'product', 'order', 'system', 'voice', 'video', 'location', 'internal_note'
  text            String
  attachmentUrl   String?
  metadata        String?        // JSON snapshot for product / order / system data
  clientMessageId String?        @unique
  isRead          Boolean        @default(false)
  isInternal      Boolean        @default(false) // Strictly filtered out for customers/sellers
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  reports         MessageReport[]

  @@index([conversationId])
  @@index([senderId])
  @@index([clientMessageId])
  @@index([createdAt])
  @@index([isInternal])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, isRead])
}

model MessageReport {
  id          String    @id @default(uuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedBy  String
  reporter    User      @relation("ReportedMessages", fields: [reportedBy], references: [id], onDelete: Cascade)
  reason      String
  description String?
  status      String    @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([messageId])
  @@index([reportedBy])
  @@index([status])
}

// ==========================================
// 10. NOTIFICATIONS, FINANCE & AUDIT
// ==========================================

model Notification {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientType   String?           @default("CUSTOMER") // CUSTOMER, SELLER, ADMIN
  category        String?           @default("SYSTEM")   // ORDER, PAYMENT, REFUND, WALLET, CHAT, etc.
  priority        String?           @default("NORMAL")   // LOW, NORMAL, HIGH, URGENT
  titleAr         String
  titleEn         String
  bodyAr          String
  bodyEn          String
  type            NotificationType  @default(SYSTEM)
  imageUrl        String?
  data            String?           // JSON payload
  deepLink        String?
  entityType      String?
  entityId        String?
  channels        String?           // JSON array e.g. ["PUSH","IN_APP"]
  status          String?           @default("SENT")     // QUEUED, PROCESSING, SENT, DELIVERED, FAILED
  isRead          Boolean           @default(false)
  readAt          DateTime?
  expiresAt       DateTime?
  scheduledAt     DateTime?
  templateId      String?
  eventId         String?
  idempotencyKey  String?
  metadata        String?           // JSON
  createdAt       DateTime          @default(now())

  deliveries      NotificationDelivery[]

  @@index([userId])
  @@index([isRead])
  @@index([category])
  @@index([status])
  @@index([recipientType])
  @@index([recipientType, isRead])
  @@index([createdAt])
  @@index([eventId])
  @@index([idempotencyKey])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationDevice {
  id                 String                 @id @default(uuid())
  deviceId           String
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform           String                 // ANDROID, IOS, WEB, WINDOWS, MACOS, LINUX
  appType            String                 @default("CUSTOMER") // CUSTOMER, SELLER, ADMIN
  deviceToken        String                 // FCM token / APNs / WebPush subscription
  pushProvider       String                 @default("FCM")      // FCM, APNS, WEB_PUSH, LOCAL
  browserInfo        String?
  appVersion         String?
  locale             String                 @default("ar")
  timezone           String                 @default("Asia/Riyadh")
  permissionStatus   String                 @default("GRANTED")  // GRANTED, DENIED, NOT_REQUESTED
  lastSeenAt         DateTime               @default(now())
  lastTokenRefreshAt DateTime               @default(now())
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  deliveries         NotificationDelivery[]

  @@unique([userId, deviceId, appType])
  @@index([userId])
  @@index([deviceToken])
  @@index([platform])
  @@index([isActive])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          String   // ORDER, PAYMENT, REFUND, WALLET, CHAT, PROMOTION, COUPON, FLASH_SALE, REWARDS, PRICE_ALERT, STOCK_ALERT, SYSTEM, SECURITY
  pushEnabled       Boolean  @default(true)
  emailEnabled      Boolean  @default(true)
  smsEnabled        Boolean  @default(false)
  inAppEnabled      Boolean  @default(true)
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String?  @default("22:00")
  quietHoursEnd     String?  @default("08:00")
  timezone          String?  @default("Asia/Riyadh")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model NotificationTemplate {
  id              String                        @id @default(uuid())
  code            String                        @unique // e.g. ORDER_SHIPPED, PAYMENT_SUCCESS
  category        String                        // ORDER, PAYMENT, REFUND, etc.
  titleAr         String
  titleEn         String
  bodyAr          String
  bodyEn          String
  defaultPriority String                        @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  channels        String                        @default("[\"PUSH\",\"IN_APP\"]") // JSON array of channels
  deepLinkPattern String?                       // e.g. souqnaa://orders/{{orderId}}
  version         Int                           @default(1)
  status          String                        @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  variables       String?                       // JSON description of variables
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  versions        NotificationTemplateVersion[]

  @@index([code])
  @@index([category])
}

model NotificationTemplateVersion {
  id              String               @id @default(uuid())
  templateId      String
  template        NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version         Int
  titleAr         String
  titleEn         String
  bodyAr          String
  bodyEn          String
  channels        String
  deepLinkPattern String?
  status          String               @default("PUBLISHED")
  changeNote      String?
  createdAt       DateTime             @default(now())

  @@unique([templateId, version])
  @@index([templateId])
}

model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String?
  notification   Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  recipientId    String
  deviceId       String?
  device         NotificationDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  channel        String              // PUSH, IN_APP, EMAIL, SMS, REAL_TIME, WEB_PUSH, DESKTOP
  provider       String              // FCM, WEBSOCKET, SMTP, SMS_GATEWAY, LOCAL
  status         String              @default("QUEUED") // QUEUED, PROCESSING, SENT, DELIVERED, FAILED, OPENED, CLICKED, EXPIRED, CANCELLED
  attemptCount   Int                 @default(0)
  lastError      String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([notificationId])
  @@index([recipientId])
  @@index([status])
  @@index([channel])
}

model NotificationAuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String   // BROADCAST_CREATED, BROADCAST_CANCELLED, TEMPLATE_UPDATED, PREFERENCE_CHANGED, KILL_SWITCH_TOGGLED
  targetType String   // CAMPAIGN, TEMPLATE, USER, SYSTEM
  targetId   String?
  details    String?  // JSON
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model NotificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String   @unique
  device    String?  // android, ios, web
  createdAt DateTime @default(now())

  @@index([userId])
}

model BroadcastCampaign {
  id          String    @id @default(uuid())
  titleAr     String
  titleEn     String
  bodyAr      String
  bodyEn      String
  target      String    @default("ALL") // 'ALL', 'CUSTOMERS', 'SELLERS'
  status      String    @default("SENT") // 'SENT', 'SCHEDULED', 'CANCELLED'
  scheduledAt DateTime?
  sentCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model SellerBalance {
  id                    String              @id @default(uuid())
  sellerId              String              @unique
  seller                Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  availableBalance      Float               @default(0.0)
  pendingBalance        Float               @default(0.0)
  withdrawnBalance      Float               @default(0.0)
  outstandingCommission Float               @default(0.0) // Platform commission liability owed by seller
  currency              String              @default("YER")
  updatedAt             DateTime            @updatedAt

  transactions          SellerTransaction[]
}

model SellerTransaction {
  id              String          @id @default(uuid())
  sellerBalanceId String
  sellerBalance   SellerBalance   @relation(fields: [sellerBalanceId], references: [id], onDelete: Cascade)
  amount          Float
  type            TransactionType
  referenceId     String?         // Order ID or Withdrawal ID
  description     String?
  createdAt       DateTime        @default(now())

  @@index([sellerBalanceId])
}

model Withdrawal {
  id                 String              @id @default(uuid())
  sellerId           String
  seller             Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount             Float
  currency           String              @default("YER")
  bankName           String?
  iban               String?
  accountName        String?
  walletProvider     String?             // KURAIMI, CASHPAY, ONECASH, JAWALI, JAIB, YEMEN_WALLET
  walletNumberMasked String?
  walletNumberFull   String?             // Unmasked number for admin to copy and execute transfer
  holderName         String?
  savedWalletId      String?
  savedWallet        SellerSavedWallet?  @relation(fields: [savedWalletId], references: [id], onDelete: SetNull)
  status             WithdrawalStatus    @default(PENDING)
  adminNote          String?
  rejectionReason    String?
  proofImageUrl      String?             // Screenshot proof of transfer uploaded by admin
  externalRef        String?             // External transaction reference from wallet provider
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  financialStatements FinancialStatement[]

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

enum DepositStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

model WalletDeposit {
  id                String         @id @default(uuid())
  userType          UserRoleType   // CUSTOMER or SELLER
  userId            String
  user              User           @relation("UserDeposits", fields: [userId], references: [id], onDelete: Cascade)
  sellerId          String?
  seller            Seller?        @relation("SellerDeposits", fields: [sellerId], references: [id], onDelete: Cascade)
  amount            Float
  approvedAmount    Float?         // Authoritative amount verified/approved by Admin
  outstandingBefore Float?         // Outstanding liability before deposit approval
  outstandingAfter  Float?         // Outstanding liability after deposit approval
  currency          String         @default("YER")
  walletProvider    String         // KURAIMI, CASHPAY, ONECASH, JAWALI, JAIB, YEMEN_WALLET, BANK_TRANSFER
  transferReference String         // Reference number from bank/wallet slip
  senderName        String?        // Depositor / Sender full name
  senderPhone       String?        // Depositor phone number
  proofImageUrl     String         // URL of uploaded receipt photo
  status            DepositStatus  @default(PENDING)
  adminNote         String?
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedByAdmin   User?          @relation("AdminReviewedDeposits", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([sellerId])
  @@index([userType])
  @@index([status])
  @@index([createdAt])
}

enum OutstandingStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  WAIVED
  ADJUSTED
}

model SellerOutstanding {
  id              String            @id @default(uuid())
  sellerId        String
  seller          Seller            @relation("SellerOutstandings", fields: [sellerId], references: [id], onDelete: Cascade)
  sourceType      String            @default("ORDER_COMMISSION") // ORDER_COMMISSION, ADJUSTMENT, MANUAL
  sourceReference String?           // sellerOrderId or orderNumber
  amount          Float             // Initial outstanding liability amount
  paidAmount      Float             @default(0.0)
  remainingAmount Float             // amount - paidAmount
  currency        String            @default("YER")
  status          OutstandingStatus @default(OPEN)
  warningLevel    String            @default("NORMAL") // NORMAL, WARNING, CRITICAL, RESTRICTED
  dueAt           DateTime?
  metadata        String?           // JSON
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([sellerId, status])
}

model SellerSavedWallet {
  id                 String       @id @default(uuid())
  sellerId           String
  seller             Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  provider           String       // KURAIMI, CASHPAY, ONECASH, JAWALI, JAIB, YEMEN_WALLET
  walletNumberMasked String
  walletNumberFull   String?      // Unmasked — used by admin to copy and execute transfer
  holderName         String?
  isVerified         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  withdrawals        Withdrawal[]

  @@index([sellerId])
}

model Commission {
  id            String   @id @default(uuid())
  sellerOrderId String   @unique
  rate          Float
  amount        Float
  createdAt     DateTime @default(now())
}

model Refund {
  id        String   @id @default(uuid())
  orderId   String
  amount    Float
  reason    String
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Dispute {
  id          String        @id @default(uuid())
  customerId  String
  customer    User          @relation("CustomerDisputes", fields: [customerId], references: [id])
  sellerId    String
  seller      Seller        @relation("SellerDisputes", fields: [sellerId], references: [id])
  orderId     String
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  decision    String?       // FULL_REFUND, PARTIAL_REFUND, REJECTED, SELLER_FAVOR
  refundAmount Float?
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. 'USER_LOGIN', 'ORDER_UPDATE', 'SELLER_APPROVED'
  resource  String   // e.g. 'orders', 'users'
  ipAddress String?
  userAgent String?
  details   String?  // JSON formatted changes
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ==========================================
// SOCIAL / FOLLOW SYSTEM
// ==========================================

/// Core bidirectional follow relationship.
/// relationshipType distinguishes CUSTOMER_TO_SELLER from SELLER_TO_CUSTOMER.
/// Extensible to USER_TO_USER, SELLER_TO_SELLER, etc. without schema changes.
model SocialFollow {
  id               String                 @id @default(uuid())
  followerUserId   String
  follower         User                   @relation("Follower", fields: [followerUserId], references: [id], onDelete: Cascade)
  followedUserId   String
  followed         User                   @relation("Followed", fields: [followedUserId], references: [id], onDelete: Cascade)
  relationshipType FollowRelationshipType
  status           FollowStatus           @default(FOLLOWING)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  /// Prevent duplicate follows of the same type
  @@unique([followerUserId, followedUserId, relationshipType])
  @@index([followedUserId, relationshipType])
  @@index([followerUserId, relationshipType])
  @@index([status])
  @@index([createdAt])
}

/// Denormalized per-user follower/following counters.
/// Updated atomically with every follow/unfollow.
/// Reconciled nightly by background job (SELECT COUNT(*)).
model FollowCounter {
  id               String                 @id @default(uuid())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipType FollowRelationshipType
  followerCount    Int                    @default(0)
  followingCount   Int                    @default(0)
  updatedAt        DateTime               @updatedAt

  @@unique([userId, relationshipType])
  @@index([userId])
}

/// Per-user privacy setting for who may follow them.
/// Defaults to PUBLIC (anyone can follow).
model UserFollowPrivacy {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  whoCanFollow FollowPrivacy @default(PUBLIC)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Central blocking table.
/// Blocked users cannot follow, chat, or appear in social discovery.
model UserBlock {
  id            String   @id @default(uuid())
  blockerUserId String
  blocker       User     @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUserId String
  blocked       User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

/// Optional 1:1 extension of Store for the full storefront experience.
/// Existing stores have NULL row until seller uploads a banner/logo.
/// Storefront UI falls back to Store.logo / Store.cover when NULL.
model StoreEnhancement {
  id                  String   @id @default(uuid())
  storeId             String   @unique
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Responsive banner images (uploaded to R2/S3)
  bannerDesktop       String?
  bannerTablet        String?
  bannerMobile        String?
  bannerTitleAr       String?
  bannerTitleEn       String?
  bannerSubtitleAr    String?
  bannerSubtitleEn    String?
  bannerCtaTextAr     String?
  bannerCtaTextEn     String?
  bannerCtaUrl        String?

  // Multi-size logo variants (generated by Sharp on upload)
  logoOriginal        String?
  logoThumbnail       String?  // 64px
  logoSmall           String?  // 128px
  logoMedium          String?  // 256px

  // Social counters — denormalized, corrected nightly by background job
  followerCount       Int      @default(0)
  followingCount      Int      @default(0)

  // Store metadata for storefront display
  joinedDate          DateTime @default(now())
  responseRate        Float?   // 0.0–1.0 percentage
  responseTimeMinutes Int?     // average response time in minutes
  totalSoldCount      Int      @default(0)

  // Follow analytics — denormalized for dashboard quick access
  newFollowersToday   Int      @default(0)
  newFollowersWeek    Int      @default(0)
  newFollowersMonth   Int      @default(0)

  updatedAt           DateTime @updatedAt

  @@index([storeId])
}

