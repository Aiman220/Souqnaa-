enum BannerCtaType {
  SHOP_NOW
  BUY_NOW
  VIEW_PRODUCTS
  VIEW_CATEGORY
  VIEW_STORE
  COLLECT_VOUCHER
  VIEW_FLASH_SALE
  VIEW_CAMPAIGN
  VIEW_BRAND
  SEARCH
  OPEN_URL
  NONE
}

enum BannerAnalyticsEventType {
  IMPRESSION
  VIEWABILITY
  CLICK
  CONVERSION
}

model Campaign {
  id               String                 @id @default(uuid())
  name             String
  slug             String                 @unique
  description      String?
  campaignType     CampaignType           @default(GENERAL)
  status           CampaignStatus         @default(DRAFT)
  startAt          DateTime
  endAt            DateTime
  priority         Int                    @default(0)
  ownerType        String                 @default("ADMIN") // "ADMIN", "SELLER"
  ownerId          String?                // sellerId or storeId
  budget           Float?                 @default(0)
  currency         String                 @default("YER")
  timezone         String                 @default("Asia/Aden")
  targetingEnabled Boolean                @default(false)
  analyticsEnabled Boolean                @default(true)
  heroAsset        String?
  mobileAsset      String?
  tabletAsset      String?
  desktopAsset     String?
  landingPageConfig Json?                 @default("{}")
  eligibilityRules  Json?                 @default("{}")
  nameAr           String?
  nameEn           String?
  code             String?
  targetingMode    String                 @default("ALL_ELIGIBLE_PRODUCTS") // "ALL_ELIGIBLE_PRODUCTS", "SPECIFIC_PRODUCTS", "CATEGORIES", "SELLERS", "BRANDS", "CUSTOM_RULES"
  badgeEnabled     Boolean                @default(false)
  badgePosition    String                 @default("BOTTOM_LEFT") // "BOTTOM_LEFT", "BOTTOM_RIGHT", "TOP_LEFT", "TOP_RIGHT"
  badgeDisplayMode String                 @default("PRIMARY_BADGE") // "PRIMARY_BADGE", "BADGE_DISABLED", "MULTIPLE_BADGES"
  badgeClickable   Boolean                @default(true)
  landingPageUri   String?
  badgeAssetVersion Int                   @default(1)
  createdBy        String?
  approvedBy       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  promotionalBanners PromotionalBanner[]
  targetingRules     CampaignTargetingRule[]
  schedules          CampaignSchedule[]
  variants           CampaignVariant[]
  attributions       CampaignAttribution[]
  frequencyCaps      BannerFrequencyCap[]
  analyticsEvents    BannerAnalyticsEvent[]
  campaignProducts   CampaignProduct[]
  campaignSellers    CampaignSeller[]
  shippingPromotions ShippingPromotion[]
  badgeAssets        CampaignBadgeAsset[]

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([priority])
  @@index([ownerId])
  @@index([campaignType])
  @@index([badgeEnabled])
}

model CampaignBadgeAsset {
  id           String    @id @default(uuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  locale       String    @default("UNIVERSAL") // "UNIVERSAL", "AR", "EN"
  assetUrl     String
  thumbnailUrl String?
  mobileUrl    String?
  tabletUrl    String?
  webUrl       String?
  width        Int?
  height       Int?
  mimeType     String?
  fileSize     Int?
  assetVersion String    @default("v1")
  altText      String?
  altTextAr    String?
  altTextEn    String?
  isDefault    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([campaignId])
  @@index([campaignId, locale])
}

model BannerPlacement {
  id                String            @id @default(uuid())
  key               String            @unique // e.g. HOME_HERO, HOME_SECONDARY, HOME_VOUCHER, CATEGORY_TOP
  name              String
  description       String?
  pageType          PlacementPageType @default(HOME)
  slotType          PlacementSlotType @default(CAROUSEL)
  maxItems          Int               @default(5)
  carouselEnabled   Boolean           @default(true)
  autoplayEnabled   Boolean           @default(true)
  autoplayInterval  Int               @default(4000) // ms
  desktopEnabled    Boolean           @default(true)
  tabletEnabled     Boolean           @default(true)
  mobileEnabled     Boolean           @default(true)
  displayOrder      Int               @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

