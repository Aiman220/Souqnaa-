model DeepLink {
  id              String             @id @default(uuid())
  type            DeepLinkType       @default(PRODUCT)
  targetId        String?
  path            String
  queryParameters Json?              @default("{}")
  metadata        Json?              @default("{}")
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  banners         PromotionalBanner[]

  @@index([type])
  @@index([targetId])
}

model PromotionalBanner {
  id               String                 @id @default(uuid())
  campaignId       String
  campaign         Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name             String
  title            String?
  subtitle         String?
  description      String?
  desktopImageUrl  String?
  tabletImageUrl   String?
  mobileImageUrl   String
  thumbnailUrl     String?
  altText          String?
  placementId      String
  placement        BannerPlacement        @relation(fields: [placementId], references: [id], onDelete: Cascade)
  bannerType       BannerType             @default(CAROUSEL)
  status           BannerStatus           @default(DRAFT)
  priority         Int                    @default(0)
  startAt          DateTime?
  endAt            DateTime?
  displayOrder     Int                    @default(0)
  targetingEnabled Boolean                @default(false)
  deepLinkId       String?
  deepLink         DeepLink?              @relation(fields: [deepLinkId], references: [id], onDelete: SetNull)
  ctaText          String?
  ctaType          BannerCtaType          @default(SHOP_NOW)
  backgroundColor  String?                @default("#FFFFFF")
  textColor        String?                @default("#000000")
  isActive         Boolean                @default(true)
  impressionCount  Int                    @default(0)
  clickCount       Int                    @default(0)
  conversionCount  Int                    @default(0)
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  translations     BannerTranslation[]
  targetingRules   CampaignTargetingRule[]
  analyticsEvents  BannerAnalyticsEvent[]
  attributions     CampaignAttribution[]
  frequencyCaps    BannerFrequencyCap[]
  variants         CampaignVariant[]

  @@index([campaignId])
  @@index([placementId])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([priority])
  @@index([displayOrder])
  @@index([isActive])
}

model BannerTranslation {
  id          String            @id @default(uuid())
  bannerId    String
  banner      PromotionalBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  locale      String            // "ar", "en"
  title       String?
  subtitle    String?
  description String?
  ctaText     String?
  imageUrl    String?
  altText     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([bannerId, locale])
  @@index([bannerId])
  @@index([locale])
}

model CampaignTargetingRule {
  id          String             @id @default(uuid())
  campaignId  String?
  campaign    Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bannerId    String?
  banner      PromotionalBanner? @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  ruleGroup   String             @default("ALL") // "ALL" (AND), "ANY" (OR), "NONE" (NOT)
  ruleType    String             // "CUSTOMER_SEGMENT", "GEO_COUNTRY", "GEO_CITY", "LANGUAGE", "PLATFORM", "CART_VALUE", "ORDER_HISTORY"
  operator    String             @default("EQUALS") // "EQUALS", "NOT_EQUALS", "IN", "NOT_IN", "GREATER_THAN", "LESS_THAN"
  value       String             // JSON string or literal
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([campaignId])
  @@index([bannerId])
  @@index([ruleType])
}

model CampaignAudienceSegment {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  segmentType String   @default("ALL_USERS")
  rules       Json?    @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CampaignSchedule {
  id             String   @id @default(uuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduleType   String   @default("ONCE") // "ONCE", "DAILY", "WEEKLY", "SPECIFIC_DATES"
  startDate      DateTime
  endDate        DateTime
  startTimeOfDay String?  @default("00:00") // "HH:mm"
  endTimeOfDay   String?  @default("23:59") // "HH:mm"
  daysOfWeek     String?  @default("[]")    // JSON array of [0..6]
  timezone       String   @default("Asia/Aden")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([campaignId])
}

model BannerAnalyticsEvent {
  id           String                   @id @default(uuid())
  bannerId     String
  banner       PromotionalBanner        @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placementId  String
  placement    BannerPlacement          @relation(fields: [placementId], references: [id], onDelete: Cascade)
  eventType    BannerAnalyticsEventType
  customerId   String?
  sessionId    String?
  anonymousId  String?
  platform     String?                  @default("MOBILE") // "ANDROID", "IOS", "WEB", "TABLET", "DESKTOP"
  deviceType   String?
  locale       String?                  @default("ar")
  ipAddress    String?
  metadata     Json?                    @default("{}")
  createdAt    DateTime                 @default(now())

  @@index([bannerId])
  @@index([campaignId])
  @@index([placementId])
  @@index([eventType])
  @@index([customerId])
  @@index([sessionId])
  @@index([createdAt])
}

model CampaignAttribution {
  id                    String            @id @default(uuid())
  campaignId            String
  campaign              Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bannerId              String
  banner                PromotionalBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  placementId           String
  placement             BannerPlacement   @relation(fields: [placementId], references: [id], onDelete: Cascade)
  customerId            String?
  sessionId             String?
  orderId               String?
  touchpointType        String            @default("CLICK") // "CLICK", "IMPRESSION"
  revenue               Float             @default(0.0)
  currency              String            @default("YER")
  attributionWindowDays Int               @default(7)
  convertedAt           DateTime          @default(now())

  @@index([campaignId])
  @@index([bannerId])
  @@index([customerId])
  @@index([orderId])
}

model BannerFrequencyCap {
  id                      String             @id @default(uuid())
  bannerId                String?
  banner                  PromotionalBanner? @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  campaignId              String?
  campaign                Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  maxImpressionsPerDay    Int                @default(3)
  maxImpressionsPerSession Int               @default(2)
  cooldownMinutes         Int                @default(60)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([bannerId])
  @@index([campaignId])
}

model CampaignVariant {
  id                String            @id @default(uuid())
  campaignId        String
  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bannerId          String
  banner            PromotionalBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  variantName       String            @default("A")
  trafficAllocation Int               @default(50)
  isControl         Boolean           @default(false)
  createdAt         DateTime          @default(now())

  @@index([campaignId])
  @@index([bannerId])
}

// Mega Campaign seller-submitted products with concurrency-safe stock reservation
model CampaignProduct {
  id              String                @id @default(uuid())
  campaignId      String
  campaign        Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)

  status          CampaignProductStatus @default(SUBMITTED)

  originalPrice   Float
  campaignPrice   Float
  discountPercent Float

  campaignStock   Int                   @default(0)
  reservedStock   Int                   @default(0)
  soldStock       Int                   @default(0)
  purchaseLimit   Int                   @default(1)

  adminNote       String?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([campaignId, productId, variantId])
  @@index([campaignId, status])
  @@index([sellerId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
}

// Mega Campaign participating sellers
model CampaignSeller {
  id              String                @id @default(uuid())
  campaignId      String
  campaign        Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status          String                @default("APPROVED") // "REGISTERED", "APPROVED", "REJECTED"
  isFeatured      Boolean               @default(false)
  joinedAt        DateTime              @default(now())

  @@unique([campaignId, sellerId])
  @@index([campaignId])
  @@index([sellerId])
}

// ==========================================
// 13. SELLER MARKETING / PROMOTION ENGINE
// ==========================================

enum SellerPromotionStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  PAID
  ADMIN_REVIEW
  APPROVED
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ADMIN_REJECTED
}

enum SellerPromotionType {
  PRODUCT       // Promote a specific product or set of products
  STORE         // Promote seller storefront
  COLLECTION    // Promote a product collection
  CAMPAIGN      // Sponsor participation in a platform campaign
}

enum SellerPackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Admin-configurable advertising packages.
/// Sellers pick one of these when creating a promotion.
model SellerPromotionPackage {
  id                    String              @id @default(uuid())
  name                  String              // e.g. "Basic", "Standard", "Premium", "Home"
  nameAr                String
  description           String?
  descriptionAr         String?
  placementKey          String              // Maps to BannerPlacement.key
  promotionType         SellerPromotionType @default(PRODUCT)
  status                SellerPackageStatus @default(ACTIVE)

  // Pricing
  price                 Float               // Total package price in currency
  currency              String              @default("YER")

  // Duration
  durationDays          Int                 @default(7)   // How many days the promotion runs

  // Limits
  impressionLimit       Int?                // null = unlimited
  clickLimit            Int?
  dailyImpressionLimit  Int?

  // Approval rules
  requiresAdminApproval Boolean            @default(true)  // All promotions require approval per user decision

  // Targeting capabilities included in package
  allowsCategoryTarget  Boolean            @default(false)
  allowsGeoTarget       Boolean            @default(false)
  allowsCustomCreative  Boolean            @default(false) // Can seller upload custom image

  // Concurrent limits
  maxConcurrent         Int                @default(1)     // Max active promotions per seller on this package

  displayOrder          Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  promotions            SellerPromotion[]

  @@index([status])
  @@index([placementKey])
}

/// Core seller promotion entity — full paid lifecycle.
/// Replaces the old seller-banner flow entirely.
model SellerPromotion {
  id                    String                  @id @default(uuid())
  sellerId              String
  seller                Seller                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  packageId             String
  package               SellerPromotionPackage  @relation(fields: [packageId], references: [id])

  promotionType         SellerPromotionType     @default(PRODUCT)
  status                SellerPromotionStatus   @default(DRAFT)

  // Placement (copied from package at creation for immutability)
  placementKey          String

  // Budget / spend tracking
  totalBudget           Float                   // = package price at time of creation
  spentAmount           Float                   @default(0.0)
  remainingBudget       Float                   // = totalBudget - spentAmount (kept in sync)
  currency              String                  @default("YER")

  // Creative (optional — seller may upload or system auto-generates)
  mobileImageUrl        String?
  tabletImageUrl        String?
  desktopImageUrl       String?
  customCreativeEnabled Boolean                 @default(false)

  // Destination deep link
  deepLinkType          String?                 // PRODUCT, STORE, SEARCH, etc.
  deepLinkTargetId      String?
  deepLinkPath          String?

  // Scheduling
  startAt               DateTime?
  endAt                 DateTime?               // set at approval time = startAt + package.durationDays

  // Analytics counters (denormalized for fast dashboard reads)
  impressionCount       Int                     @default(0)
  clickCount            Int                     @default(0)
  conversionCount       Int                     @default(0)
  orderCount            Int                     @default(0)
  revenue               Float                   @default(0.0)

  // Moderation
  adminNote             String?
  rejectionReason       String?

  // Timestamps
  submittedAt           DateTime?
  paidAt                DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  startedAt             DateTime?
  pausedAt              DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  items                 SellerPromotionItem[]
  payments              SellerPromotionPayment[]
  dailyStats            PromotionDailyStats[]
  servings              SponsoredProductServing[]

  @@index([sellerId, status])
  @@index([placementKey, status])
  @@index([startAt, endAt])
  @@index([status])
  @@index([createdAt])
}

/// Links a seller promotion to specific products or stores.
/// Product ownership is enforced server-side: product.store.sellerId === sellerId.
model SellerPromotionItem {
  id            String          @id @default(uuid())
  promotionId   String
  promotion     SellerPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId     String?
  storeId       String?
  collectionTag String?         // Free-form tag for product collections
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())

  @@index([promotionId])
  @@index([productId])
  @@index([storeId])
}

/// Immutable financial record for every promotion payment.
/// Never deleted. Supports refunds and audit trail.
model SellerPromotionPayment {
  id                String          @id @default(uuid())
  promotionId       String
  promotion         SellerPromotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  sellerId          String

  // Amounts
  amount            Float           // Charged or refunded (positive = charge, negative = refund)
  currency          String          @default("YER")

  // References into SellerBalance / SellerTransaction
  sellerBalanceId   String?         // SellerBalance.id at time of payment
  transactionRef    String?         // SellerTransaction.id

  paymentType       String          @default("CHARGE") // "CHARGE" | "REFUND" | "ADJUSTMENT"
  status            String          @default("COMPLETED") // "COMPLETED" | "FAILED" | "PENDING"

  // Idempotency
  idempotencyKey    String          @unique

  note              String?
  createdAt         DateTime        @default(now())

  @@index([promotionId])
  @@index([sellerId])
  @@index([idempotencyKey])
  @@index([createdAt])
}

/// Daily analytics aggregates per promotion.
/// Populated by background job from SponsoredProductServing events.
model PromotionDailyStats {
  id              String          @id @default(uuid())
  promotionId     String
  promotion       SellerPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  date            DateTime        // Date only (truncated to day)

  impressions     Int             @default(0)
  clicks          Int             @default(0)
  addToCarts      Int             @default(0)
  orders          Int             @default(0)
  revenue         Float           @default(0.0)
  spend           Float           @default(0.0)
  ctr             Float           @default(0.0) // clicks / impressions
  conversionRate  Float           @default(0.0) // orders / clicks
  roas            Float           @default(0.0) // revenue / spend

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([promotionId, date])
  @@index([promotionId])
  @@index([date])
}

/// Low-level serving event log for rotation tracking and deduplication.
/// Used to enforce frequency caps and track unique impressions.
model SponsoredProductServing {
  id            String          @id @default(uuid())
  promotionId   String
  promotion     SellerPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId     String?
  storeId       String?

  customerId    String?         // null for anonymous
  sessionId     String?
  anonymousId   String?
  platform      String?         @default("MOBILE")
  deviceType    String?

  eventType     String          // "IMPRESSION" | "CLICK" | "ADD_TO_CART" | "PURCHASE"
  idempotencyKey String?        // Prevents double-counting same client event

  createdAt     DateTime        @default(now())

  @@index([promotionId, eventType])
  @@index([customerId, promotionId])
  @@index([sessionId, promotionId])
  @@index([createdAt])
  @@index([idempotencyKey])
}

// ==========================================
// SEARCH & ANALYTICS
// ==========================================

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, query])
  @@index([userId, updatedAt(sort: Desc)])
}

model SearchQueryLog {
  id              String   @id @default(uuid())
  query           String
  normalizedQuery String
  userId          String?
  resultCount     Int      @default(0)
  isVisual        Boolean  @default(false)
  hasResults      Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([normalizedQuery, createdAt])
  @@index([createdAt])
  @@index([hasResults, createdAt])
}

// ==========================================
// 12. REFUNDS, DISPUTES & FINANCIAL LEDGER
// ==========================================

enum RefundStatus {
  DRAFT
  SUBMITTED
  UNDER_SELLER_REVIEW
  SELLER_ACCEPTED
  SELLER_REJECTED
  CUSTOMER_ACCEPTED
  CUSTOMER_DISPUTED
  ADMIN_REVIEW
  ADMIN_APPROVED
  ADMIN_REJECTED
  REFUND_PENDING
  REFUND_PROCESSING
  REFUND_COMPLETED
  REFUND_FAILED
  EXPIRED
  CANCELLED
  CLOSED

  // Legacy compatibility
  REQUESTED
  SELLER_REVIEW
  APPROVED
  REFUNDED
  REJECTED
  DISPUTED
}

enum RefundDestination {
  ORIGINAL_PAYMENT_METHOD
  CUSTOMER_WALLET
  MANUAL_WALLET_TRANSFER
  BANK_TRANSFER
}

enum ManualTransferStatus {
  REQUESTED
  ADMIN_REVIEW
  APPROVED
  PROCESSING
  PROOF_REQUIRED
  PROOF_SUBMITTED
  VERIFICATION_PENDING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
}

enum WalletTxType {
  REFUND_CREDIT
  REFUND_REVERSAL
  MANUAL_TRANSFER_PENDING
  MANUAL_TRANSFER_COMPLETED
  MANUAL_TRANSFER_FAILED
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  WITHDRAWAL_REQUEST
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_FAILED
  ORDER_PAYMENT
  ORDER_REFUND
}

enum WalletTxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum RefundActorType {
  CUSTOMER
  SELLER
  ADMIN
  SYSTEM
}

enum RefundMethod {
  ORIGINAL_PAYMENT
  WALLET
  BANK_TRANSFER
  CASH
  MANUAL_ADJUSTMENT
}

enum FinancialTransactionType {
  REFUND_CUSTOMER
  COMMISSION_REVERSAL
  SELLER_BALANCE_ADJUSTMENT
  PAYMENT_PROVIDER_REFUND
  PAYOUT_SETTLEMENT
  ORDER_PAYMENT
  SHIPPING_SUBSIDY_PLATFORM
  SELLER_DELIVERY_REIMBURSEMENT
  SELLER_SHIPPING_CONTRIBUTION
}

model RefundReason {
  id                  String          @id @default(uuid())
  code                String          @unique
  nameAr              String
  nameEn              String
  requiresDescription Boolean         @default(false)
  isActive            Boolean         @default(true)
  displayOrder        Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  refundRequests      RefundRequest[]

  @@index([isActive])
}

model RefundPolicyConfig {
  id                         String   @id @default(uuid())
  refundWindowDays           Int      @default(14)
  refundWindowEnabled        Boolean  @default(true)
  allowPartialRefund         Boolean  @default(true)
  allowFullRefund            Boolean  @default(true)
  allowShippingRefund        Boolean  @default(false)
  allowSellerDecision        Boolean  @default(true)
  allowCustomerDispute       Boolean  @default(true)
  adminEscalationEnabled     Boolean  @default(true)
  manualWalletRefundEnabled  Boolean  @default(true)
  dualApprovalEnabled        Boolean  @default(false)
  dualApprovalThresholdYER   Float    @default(50000.0)
  updatedBy                  String?
  updatedAt                  DateTime @updatedAt
  createdAt                  DateTime @default(now())
}

model RefundRequest {
  id                     String                 @id @default(uuid())
  refundNumber           String                 @unique
  orderId                String
  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId          String?
  sellerOrder            SellerOrder?           @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  customerId             String
  customer               User                   @relation("CustomerRefundRequests", fields: [customerId], references: [id])
  sellerId               String
  seller                 Seller                 @relation("SellerRefundRequests", fields: [sellerId], references: [id])
  status                 RefundStatus           @default(SUBMITTED)
  reasonId               String?
  reason                 RefundReason?          @relation(fields: [reasonId], references: [id])
  reasonText             String
  description            String?
  requestedAmount        Float
  approvedAmount         Float?
  currency               String                 @default("YER")
  refundMethod           RefundMethod?
  destination            RefundDestination?     @default(CUSTOMER_WALLET)
  customerNote           String?
  sellerResponse         String?
  sellerRejectionReason  String?
  adminDecision          String?                // APPROVE_FULL, APPROVE_PARTIAL, REJECT
  adminDecisionReason    String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  resolvedAt             DateTime?

  items                  RefundRequestItem[]
  evidence               RefundEvidence[]
  statusHistory          RefundStatusHistory[]
  messages               RefundMessage[]
  financialTransactions  FinancialTransaction[]
  snapshot               RefundSnapshot?
  sellerDecisions        SellerRefundDecision[]
  customerDecisions      CustomerRefundDecision[]
  executionLock          RefundExecutionLock?
  adjustments            RefundAdjustment[]
  manualTransfer         ManualWalletTransferRequest?
  refundTaxRecords       RefundTaxRecord[]
  walletTransactions     WalletTransaction[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([sellerId, status, createdAt(sort: Desc)])
}

model SellerRefundDecision {
  id          String        @id @default(uuid())
  refundId    String
  refund      RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  decision    String        // ACCEPT, REJECT
  reason      String?
  amount      Float
  createdAt   DateTime      @default(now())
  createdBy   String

  @@index([refundId])
  @@index([sellerId])
}

model CustomerRefundDecision {
  id          String        @id @default(uuid())
  refundId    String
  refund      RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  decision    String        // ACCEPT_SELLER, DISPUTE
  reason      String?
  createdAt   DateTime      @default(now())

  @@index([refundId])
  @@index([customerId])
}

model RefundExecutionLock {
  id           String            @id @default(uuid())
  refundId     String            @unique
  refund       RefundRequest     @relation(fields: [refundId], references: [id], onDelete: Cascade)
  destination  RefundDestination
  lockedAt     DateTime          @default(now())
  completedAt  DateTime?
  status       String            @default("LOCKED")

  @@index([refundId])
}

model RefundAdjustment {
  id                      String        @id @default(uuid())
  refundId                String
  refund                  RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  adminId                 String
  admin                   User          @relation("AdminRefundAdjustments", fields: [adminId], references: [id])
  originalRequestedAmount  Float
  approvedAmount          Float
  difference              Float
  reason                  String
  createdAt               DateTime      @default(now())

  @@index([refundId])
  @@index([adminId])
}

model CustomerSavedWallet {
  id                 String                     @id @default(uuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String                     // KURAIMI, CASHPAY, ONECASH, JAWALI, JAIB, YEMEN_WALLET
  walletNumberMasked String
  walletNumberFull   String?                    // Unmasked — used by admin to copy and execute transfer
  holderName         String?
  isVerified         Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  withdrawals        CustomerWalletWithdrawal[]

  @@index([userId])
}

model CustomerWalletWithdrawal {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation("CustomerWithdrawals", fields: [userId], references: [id], onDelete: Cascade)
  savedWalletId        String?
  savedWallet          CustomerSavedWallet? @relation(fields: [savedWalletId], references: [id], onDelete: SetNull)
  amount               Float
  currency             String    @default("YER")
  status               String    @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  // Snapshot at request time (in case saved wallet is later deleted)
  walletProvider       String
  walletNumberMasked   String
  walletNumberFull     String    // Unmasked number for admin to execute transfer
  holderName           String?
  // Admin action fields
  adminNote            String?
  rejectionReason      String?
  proofImageUrl        String?   // Screenshot proof of transfer uploaded by admin
  externalRef          String?   // External transaction reference from wallet provider
  assignedAdminId      String?
  assignedAdmin        User?     @relation("AdminCustomerWithdrawals", fields: [assignedAdminId], references: [id])
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model WalletAccount {
  id               String              @id @default(uuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency         String              @default("YER")
  availableBalance Float               @default(0.0)
  pendingBalance   Float               @default(0.0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  ledgerEntries    WalletLedgerEntry[]
  transactions     WalletTransaction[]

  @@index([userId])
}

model WalletLedgerEntry {
  id              String         @id @default(uuid())
  walletAccountId String
  walletAccount   WalletAccount  @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  type            WalletTxType
  direction       String         // CREDIT, DEBIT
  amount          Float
  currency        String         @default("YER")
  balanceBefore   Float
  balanceAfter    Float
  referenceType   String         // REFUND, MANUAL_TRANSFER, ADJUSTMENT, WITHDRAWAL
  referenceId     String?
  status          WalletTxStatus @default(COMPLETED)
  description     String?
  createdAt       DateTime       @default(now())
  createdBy       String?
  creator         User?          @relation("WalletLedgerEntryCreator", fields: [createdBy], references: [id])

  @@index([walletAccountId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model WalletTransaction {
  id                     String         @id @default(uuid())
  walletAccountId        String
  walletAccount          WalletAccount  @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  refundId               String?
  refund                 RefundRequest? @relation(fields: [refundId], references: [id], onDelete: SetNull)
  type                   WalletTxType
  status                 WalletTxStatus @default(PENDING)
  amount                 Float
  currency               String         @default("YER")
  referenceNumber        String         @unique
  externalReference      String?
  description            String?
  metadata               String?        // JSON
  createdAt              DateTime       @default(now())
  completedAt            DateTime?

  @@unique([refundId, type])
  @@index([walletAccountId])
  @@index([refundId])
  @@index([type])
  @@index([status])
  @@index([walletAccountId, createdAt(sort: Desc)])
}

model ManualWalletTransferRequest {
  id                           String               @id @default(uuid())
  refundId                     String               @unique
  refund                       RefundRequest        @relation(fields: [refundId], references: [id], onDelete: Cascade)
  customerId                   String
  customer                     User                 @relation("CustomerManualTransfers", fields: [customerId], references: [id])
  walletProvider               String               // Kuraimi, CashPay, OneCash, Jawali, Jaib, YemenWallet
  walletNumberMasked           String               // e.g. 77******123
  walletNumberEncrypted        String?              // Full wallet number storage for authorized financial admins
  holderName                   String?
  amount                       Float
  currency                     String               @default("YER")
  status                       ManualTransferStatus @default(REQUESTED)
  externalTransactionReference String?
  adminNote                    String?
  rejectionReason              String?
  assignedAdminId              String?
  assignedAdmin                User?                @relation("AdminAssignedManualTransfers", fields: [assignedAdminId], references: [id])
  verifiedByAdminId            String?
  verifiedByAdmin              User?                @relation("AdminVerifiedManualTransfers", fields: [verifiedByAdminId], references: [id])
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  completedAt                  DateTime?

  proofs                       TransferProof[]

  @@index([customerId])
  @@index([status])
  @@index([walletProvider])
  @@index([createdAt])
}

model TransferProof {
  id         String                      @id @default(uuid())
  transferId String
  transfer   ManualWalletTransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileType   String                      // image/jpeg, image/png, application/pdf
  fileHash   String                      // SHA-256 hash
  fileSize   Int                         @default(0)
  uploadedBy String
  uploader   User                        @relation("TransferProofUploader", fields: [uploadedBy], references: [id])
  uploadedAt DateTime                    @default(now())

  @@index([transferId])
  @@index([uploadedBy])
}

model RefundRequestItem {
  id               String        @id @default(uuid())
  refundRequestId  String
  refundRequest    RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  orderItemId      String
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantity         Int
  requestedAmount  Float
  approvedAmount   Float?
  createdAt        DateTime      @default(now())

  @@index([refundRequestId])
  @@index([orderItemId])
}

model RefundEvidence {
  id               String          @id @default(uuid())
  refundRequestId  String
  refundRequest    RefundRequest   @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  uploadedBy       String
  uploader         User            @relation("RefundEvidenceUploader", fields: [uploadedBy], references: [id])
  uploadedByRole   RefundActorType
  fileUrl          String
  fileType         String
  fileSize         Int             @default(0)
  mimeType         String
  description      String?
  createdAt        DateTime        @default(now())

  @@index([refundRequestId])
  @@index([uploadedBy])
}

model RefundStatusHistory {
  id               String          @id @default(uuid())
  refundRequestId  String
  refundRequest    RefundRequest   @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  fromStatus       RefundStatus?
  toStatus         RefundStatus
  changedBy        String
  actor            User            @relation("RefundHistoryActor", fields: [changedBy], references: [id])
  actorType        RefundActorType
  reason           String?
  metadata         String?         // JSON
  createdAt        DateTime        @default(now())

  @@index([refundRequestId])
  @@index([changedBy])
}

model RefundMessage {
  id                  String          @id @default(uuid())
  refundRequestId     String
  refundRequest       RefundRequest   @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  senderId            String
  sender              User            @relation("RefundMessageSender", fields: [senderId], references: [id])
  senderRole          RefundActorType
  message             String
  isPrivateAdminNote  Boolean         @default(false)
  createdAt           DateTime        @default(now())

  @@index([refundRequestId])
  @@index([senderId])
}

model FinancialTransaction {
  id                 String                   @id @default(uuid())
  transactionNumber  String                   @unique
  type               FinancialTransactionType
  orderId            String?
  order              Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  refundRequestId    String?
  refundRequest      RefundRequest?           @relation(fields: [refundRequestId], references: [id], onDelete: SetNull)
  sellerId           String?
  seller             Seller?                  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  amount             Float
  currency           String                   @default("YER")
  direction          String                   // DEBIT, CREDIT
  referenceId        String?
  description        String?
  metadata           String?                  // JSON
  createdAt          DateTime                 @default(now())

  @@index([orderId])
  @@index([refundRequestId])
  @@index([sellerId])
  @@index([type])
  @@index([createdAt])
}

model RefundSnapshot {
  id                   String        @id @default(uuid())
  refundRequestId      String        @unique
  refundRequest        RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  originalOrderAmount  Float
  originalPaidAmount   Float
  requestedAmount      Float
  approvedAmount       Float
  commissionAmount     Float
  commissionReversal   Float
  sellerAdjustment     Float
  refundMethod         String
  currency             String        @default("YER")
  pricingVersion       String?
  metadata             String?       // JSON
  createdAt            DateTime      @default(now())
}

// ==========================================
// 11. RECOMMENDATION ENGINE & BEHAVIORAL ML
// ==========================================

enum RecommendationEventType {
  PRODUCT_VIEW
  PRODUCT_CLICK
  SEARCH
  SEARCH_RESULT_CLICK
  ADD_TO_CART
  REMOVE_FROM_CART
  ADD_TO_WISHLIST
  REMOVE_FROM_WISHLIST
  PURCHASE
  ORDER_COMPLETED
  PRODUCT_SHARE
  PRODUCT_IMAGE_VIEW
  PRODUCT_REVIEW
  PRODUCT_RATING
  CATEGORY_VIEW
  SELLER_VIEW
  FOLLOW_SELLER
  UNFOLLOW_SELLER
  COUPON_USED
  FLASH_SALE_CLICK
  CAMPAIGN_CLICK
}

enum RecommendationType {
  FOR_YOU
  TRENDING
  POPULAR
  NEW_ARRIVALS
  SIMILAR_PRODUCTS
  FREQUENTLY_BOUGHT_TOGETHER
  RECENTLY_VIEWED
  BECAUSE_YOU_VIEWED
  BECAUSE_YOU_BOUGHT
  BASED_ON_WISHLIST
  BASED_ON_CART
  CATEGORY_RECOMMENDATIONS
  SELLER_RECOMMENDATIONS
  PRICE_DROP_RECOMMENDATIONS
  BACK_IN_STOCK_RECOMMENDATIONS
  CAMPAIGN_RECOMMENDATIONS
  FLASH_SALE_RECOMMENDATIONS
  MEGA_CAMPAIGN_RECOMMENDATIONS
  PERSONALIZED_HOME
}

model RecommendationEvent {
  id          String                  @id @default(uuid())
  userId      String?
  user        User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId   String
  eventType   RecommendationEventType
  productId   String?
  product     Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sellerId    String?
  seller      Seller?                 @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  searchQuery String?
  orderId     String?
  platform    String?                 @default("flutter_customer")
  appVersion  String?
  metadata    String?                 // JSON payload
  timestamp   DateTime                @default(now())

  @@index([userId, eventType])
  @@index([sessionId, eventType])
  @@index([productId, timestamp])
  @@index([eventType, timestamp])
  @@index([categoryId, timestamp])
  @@index([sellerId, timestamp])
  @@index([timestamp])
}

model UserRecommendationProfile {
  id                             String   @id @default(uuid())
  userId                         String?  @unique
  user                           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId                      String?  @unique
  favoriteCategories             String?  // JSON: [{ categoryId, score, count }]
  favoriteSellers                String?  // JSON: [{ sellerId, score, count }]
  preferredPriceMin              Float?   @default(0.0)
  preferredPriceMax              Float?   @default(1000000.0)
  frequentlyViewedBrands         String?  // JSON: [{ brandId, score }]
  frequentlyPurchasedCategories  String?  // JSON: [{ categoryId, count }]
  recentSearches                 String?  // JSON: [string]
  recentProductIds               String?  // JSON: [string]
  engagementFrequency            Float    @default(1.0)
  totalInteractions              Int      @default(0)
  lastActiveAt                   DateTime @default(now())
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([lastActiveAt])
}

model ProductFeature {
  id               String   @id @default(uuid())
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId       String
  subcategoryId    String?
  sellerId         String
  brandId          String?
  price            Float
  discount         Float    @default(0.0)
  rating           Float    @default(0.0)
  reviewCount      Int      @default(0)
  soldCount        Int      @default(0)
  stock            Int      @default(0)
  isActive         Boolean  @default(true)
  isCampaign       Boolean  @default(false)
  isFlashSale      Boolean  @default(false)
  isMegaCampaign   Boolean  @default(false)
  bayesianRating   Float    @default(0.0)
  popularityScore  Float    @default(0.0)
  trendingScore    Float    @default(0.0)
  freshnessScore   Float    @default(0.0)
  qualityScore     Float    @default(0.0)
  tags             String?  // JSON array of strings
  attributes       String?  // JSON map
  updatedAt        DateTime @updatedAt

  @@index([popularityScore])
  @@index([trendingScore])
  @@index([categoryId])
  @@index([sellerId])
  @@index([isActive])
}

model ProductSimilarity {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation("ProductSimilaritySource", fields: [productId], references: [id], onDelete: Cascade)
  similarProductId String
  similarProduct   Product  @relation("ProductSimilarityTarget", fields: [similarProductId], references: [id], onDelete: Cascade)
  similarityScore  Float
  categoryScore    Float    @default(0.0)
  brandScore       Float    @default(0.0)
  priceScore       Float    @default(0.0)
  textScore        Float    @default(0.0)
  updatedAt        DateTime @updatedAt

  @@unique([productId, similarProductId])
  @@index([productId, similarityScore])
  @@index([similarProductId])
}

model ProductAssociation {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation("ProductAssociationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product  @relation("ProductAssociationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)
  score            Float
  purchaseCount    Int      @default(1)
  confidence       Float    @default(0.0)
  lift             Float    @default(0.0)
  updatedAt        DateTime @updatedAt

  @@unique([productId, relatedProductId])
  @@index([productId, score])
  @@index([relatedProductId])
}

model RecommendationCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  cacheType String   // 'USER', 'PRODUCT', 'HOME', 'TRENDING', 'POPULAR', 'CATEGORY'
  data      String   // JSON string
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([cacheKey])
  @@index([cacheType])
  @@index([expiresAt])
}

model RecommendationModel {
  id                String   @id @default(uuid())
  modelVersion      String   @unique // e.g. 'model_v1', 'model_v2'
  algorithm         String   // 'LIGHTFM_WARP', 'LIGHTFM_BPR', 'COLLABORATIVE_ALS', 'HYBRID_RULE_BASED'
  status            String   @default("ACTIVE") // 'ACTIVE', 'TRAINING', 'ARCHIVED', 'FAILED'
  artifactPath      String?
  parameters        String?  // JSON
  metrics           String?  // JSON: Precision@K, Recall@K, MAP@K, NDCG@K, HitRate@K, Coverage, Diversity
  trainingDataRange String?
  trainedAt         DateTime @default(now())
  isProduction      Boolean  @default(false)

  @@index([modelVersion])
  @@index([status])
  @@index([isProduction])
}

model RecommendationExperiment {
  id                  String    @id @default(uuid())
  experimentName      String    @unique
  status              String    @default("ACTIVE") // 'ACTIVE', 'PAUSED', 'COMPLETED'
  controlModelVersion String
  variantModelVersion String
  trafficSplit        Float     @default(0.5)
  startDate           DateTime  @default(now())
  endDate             DateTime?
  metadata            String?   // JSON

  @@index([experimentName])
  @@index([status])
}

model RecommendationMetric {
  id                  String   @id @default(uuid())
  date                DateTime @default(now())
  modelVersion        String?
  experimentId        String?
  variant             String?  // 'CONTROL', 'VARIANT'
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  cartAdditions       Int      @default(0)
  purchases           Int      @default(0)
  revenue             Float    @default(0.0)
  ctr                 Float    @default(0.0)
  conversionRate      Float    @default(0.0)
  coverage            Float    @default(0.0)
  coldStartPercentage Float    @default(0.0)
  fallbackPercentage  Float    @default(0.0)

  @@index([date])
  @@index([modelVersion])
  @@index([experimentId])
}

// ==========================================
// 41. SUPPORT CHAT CENTER & HELP DESK
// ==========================================

enum SupportRequesterType {
  CUSTOMER
  SELLER
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportConversationStatus {
  OPEN
  QUEUED
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_SELLER
  WAITING_FOR_INTERNAL
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportAgentStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

model SupportConversation {
  id                    String                    @id @default(uuid())
  conversationId        String                    @unique
  conversation          Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requesterType         SupportRequesterType      @default(CUSTOMER)
  requesterId           String
  assignedAgentId       String?
  assignedAgent         SupportAgent?             @relation(fields: [assignedAgentId], references: [id])
  departmentId          String?
  department            SupportDepartment?        @relation(fields: [departmentId], references: [id])
  categoryId            String?
  category              SupportCategory?          @relation(fields: [categoryId], references: [id])
  priority              SupportPriority           @default(NORMAL)
  status                SupportConversationStatus @default(OPEN)
  subject               String
  lastMessageId         String?
  lastMessageAt         DateTime?
  unreadCustomerCount   Int                       @default(0)
  unreadSellerCount     Int                       @default(0)
  unreadAgentCount      Int                       @default(0)
  
  // SLA tracking
  firstResponseDueAt    DateTime?
  resolutionDueAt       DateTime?
  firstResponseAt       DateTime?
  resolvedAt            DateTime?

  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  closedAt              DateTime?
  closedBy              String?
  escalatedAt           DateTime?
  escalatedBy           String?

  ticket                SupportTicket?
  transfers             SupportConversationTransfer[]
  ratings               SupportRating[]

  @@index([status])
  @@index([assignedAgentId])
  @@index([departmentId])
  @@index([priority])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([requesterId])
  @@index([status, priority, createdAt])
}

model SupportTicket {
  id                    String                    @id @default(uuid())
  ticketNumber          String                    @unique // e.g. SUP-2026-000001
  supportConversationId String                    @unique
  supportConversation   SupportConversation       @relation(fields: [supportConversationId], references: [id], onDelete: Cascade)
  requesterType         SupportRequesterType      @default(CUSTOMER)
  requesterId           String
  categoryId            String?
  category              SupportCategory?          @relation(fields: [categoryId], references: [id])
  subcategoryId         String?
  subject               String
  priority              SupportPriority           @default(NORMAL)
  status                SupportConversationStatus @default(OPEN)
  assignedAgentId       String?
  assignedAgent         SupportAgent?             @relation(fields: [assignedAgentId], references: [id])
  departmentId          String?
  department            SupportDepartment?        @relation(fields: [departmentId], references: [id])
  relatedOrderId        String?
  relatedSellerOrderId  String?
  relatedProductId      String?
  
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  resolvedAt            DateTime?
  closedAt              DateTime?

  ratings               SupportRating[]

  @@index([ticketNumber])
  @@index([requesterId])
  @@index([status])
  @@index([assignedAgentId])
  @@index([departmentId])
  @@index([relatedOrderId])
  @@index([relatedSellerOrderId])
  @@index([relatedProductId])
}

model SupportCategory {
  id              String                @id @default(uuid())
  nameAr          String
  nameEn          String
  descriptionAr   String?
  descriptionEn   String?
  requesterType   String                @default("BOTH") // CUSTOMER, SELLER, BOTH
  icon            String?
  priority        SupportPriority       @default(NORMAL)
  departmentId    String?
  department      SupportDepartment?    @relation(fields: [departmentId], references: [id])
  active          Boolean               @default(true)
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  conversations   SupportConversation[]
  tickets         SupportTicket[]
  faqs            SupportFaq[]

  @@index([active])
  @@index([requesterType])
}

model SupportDepartment {
  id                      String                @id @default(uuid())
  name                    String                @unique // e.g. GENERAL_SUPPORT, ORDERS, PAYMENTS, etc.
  nameAr                  String
  nameEn                  String
  description             String?
  active                  Boolean               @default(true)
  priority                Int                   @default(0)
  workingHours            String?               // e.g. "08:00 - 22:00"
  autoAssignmentEnabled   Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  agents                  SupportAgentDepartment[]
  conversations           SupportConversation[]
  tickets                 SupportTicket[]
  categories              SupportCategory[]
  quickReplies            SupportQuickReply[]
  transfersFrom           SupportConversationTransfer[] @relation("TransfersFromDepartment")
  transfersTo             SupportConversationTransfer[] @relation("TransfersToDepartment")

  @@index([active])
}

model SupportAgent {
  id                  String                    @id @default(uuid())
  adminUserId         String                    @unique
  user                User                      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  displayName         String
  avatar              String?
  active              Boolean                   @default(true)
  online              Boolean                   @default(false)
  maxConcurrentChats  Int                       @default(5)
  currentActiveChats  Int                       @default(0)
  status              SupportAgentStatus        @default(OFFLINE)
  lastSeenAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  departments         SupportAgentDepartment[]
  assignedConversations SupportConversation[]
  assignedTickets     SupportTicket[]
  transfersFrom       SupportConversationTransfer[] @relation("TransfersFromAgent")
  transfersTo         SupportConversationTransfer[] @relation("TransfersToAgent")

  @@index([active])
  @@index([status])
  @@index([online])
}

model SupportAgentDepartment {
  id           String            @id @default(uuid())
  agentId      String
  agent        SupportAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  departmentId String
  department   SupportDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([agentId, departmentId])
  @@index([agentId])
  @@index([departmentId])
}

model SupportConversationTransfer {
  id                String              @id @default(uuid())
  conversationId    String
  conversation      SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromAgentId       String?
  fromAgent         SupportAgent?       @relation("TransfersFromAgent", fields: [fromAgentId], references: [id])
  toAgentId         String?
  toAgent           SupportAgent?       @relation("TransfersToAgent", fields: [toAgentId], references: [id])
  fromDepartmentId  String?
  fromDepartment    SupportDepartment?  @relation("TransfersFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartmentId    String?
  toDepartment      SupportDepartment?  @relation("TransfersToDepartment", fields: [toDepartmentId], references: [id])
  reason            String?
  createdAt         DateTime            @default(now())

  @@index([conversationId])
}

model SupportQuickReply {
  id           String             @id @default(uuid())
  departmentId String?
  department   SupportDepartment? @relation(fields: [departmentId], references: [id])
  title        String
  titleAr      String?
  message      String
  messageAr    String?
  active       Boolean            @default(true)
  createdBy    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([departmentId])
  @@index([active])
}

model SupportFaq {
  id           String           @id @default(uuid())
  categoryId   String?
  category     SupportCategory? @relation(fields: [categoryId], references: [id])
  questionAr   String
  questionEn   String
  answerAr     String
  answerEn     String
  helpfulCount Int              @default(0)
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([categoryId])
  @@index([active])
}

model SupportRating {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticketId       String?
  ticket         SupportTicket?      @relation(fields: [ticketId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         Int                 // 1 - 5
  comment        String?
  createdAt      DateTime            @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([ticketId])
  @@index([rating])
}

model SupportSlaPolicy {
  id                    String          @id @default(uuid())
  priority              SupportPriority @unique
  firstResponseMinutes  Int             @default(15)
  resolutionMinutes     Int             @default(120)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

// ==========================================
// SOUQNAA COINS & REWARDS ENGINE (PHASE 42)
// ==========================================

enum RewardTxType {
  EARN
  REDEEM
  EXPIRE
  REVERSE
  REFUND_REVERSAL
  ORDER_CANCELLATION
  ADMIN_ADJUSTMENT
  CAMPAIGN_BONUS
  CHECK_IN
  MISSION_REWARD
  REVIEW_REWARD
  REFERRAL_REWARD
  PURCHASE_REWARD
  PROMOTIONAL_BONUS
}

enum RewardTxSource {
  PURCHASE
  CHECK_IN
  MISSION
  REVIEW
  REFERRAL
  CAMPAIGN
  SELLER_PROMOTION
  PLATFORM
  SYSTEM
  ADMIN
}

enum RewardTxStatus {
  PENDING
  COMPLETED
  REVERSED
  EXPIRED
  CANCELLED
  FAILED
}

enum CoinLotStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  REVERSED
}

enum RewardFundingSource {
  PLATFORM
  SELLER
  CAMPAIGN
  SYSTEM
}

enum CoinReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
  EXPIRED
}

enum MissionType {
  PURCHASE_COUNT
  PURCHASE_AMOUNT
  PRODUCT_VIEW
  WISHLIST_ADD
  FOLLOW_STORE
  REVIEW
  PHOTO_REVIEW
  VIDEO_REVIEW
  ORDER_COMPLETION
  COUPON_USE
  CATEGORY_PURCHASE
  SELLER_PURCHASE
  REFERRAL
  PROFILE_COMPLETION
}

enum MissionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum CoinCampaignType {
  DOUBLE_DATE
  MEGA_CAMPAIGN
  SEASONAL
  CATEGORY_BOOST
  SELLER_BOOST
  CUSTOM
}

enum CoinCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
  ARCHIVED
}

enum ReferralRecordStatus {
  REGISTERED
  FIRST_ORDER_PENDING
  COMPLETED
  FRAUD_SUSPECTED
  EXPIRED
}

/// Materialized customer rewards account with cached balances. Authoritative balance derived from CoinTransaction ledger.
model RewardAccount {
  id                String            @id @default(uuid())
  customerId        String            @unique
  customer          User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  availableCoins    Int               @default(0)
  pendingCoins      Int               @default(0)
  expiringSoonCoins Int               @default(0)
  lifetimeEarned    Int               @default(0)
  lifetimeRedeemed  Int               @default(0)
  lifetimeExpired   Int               @default(0)
  referralCode      String?           @unique
  currentStreak     Int               @default(0)
  longestStreak     Int               @default(0)
  lastCheckInDate   String?           // "YYYY-MM-DD"
  lastCheckInAt     DateTime?
  riskFlag          Boolean           @default(false)
  riskReason        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  coinLots          CoinLot[]
  coinTransactions  CoinTransaction[]

  @@index([customerId])
  @@index([referralCode])
  @@index([riskFlag])
}

/// Individual earning lot supporting exact FIFO expiration strategy (§8, §9)
model CoinLot {
  id              String              @id @default(uuid())
  accountId       String
  account         RewardAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  initialCoins    Int
  remainingCoins  Int
  status          CoinLotStatus       @default(ACTIVE)
  fundingSource   RewardFundingSource @default(PLATFORM)
  sellerId        String?
  campaignId      String?
  transactionId   String?
  earnedAt        DateTime            @default(now())
  expiresAt       DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([customerId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([accountId])
}

/// Immutable Double-Entry Rewards Ledger (§4, §5, §6, §58)
model CoinTransaction {
  id             String              @id @default(uuid())
  accountId      String
  account        RewardAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type           RewardTxType
  source         RewardTxSource
  fundingSource  RewardFundingSource @default(PLATFORM)
  sellerId       String?
  campaignId     String?
  missionId      String?
  coins          Int                 // Positive for credit/earn, negative for debit/redeem/expire/reverse
  balanceBefore  Int
  balanceAfter   Int
  referenceType  String?             // "ORDER", "REVIEW", "CHECK_IN", "MISSION", "REFERRAL", "MANUAL", "CAMPAIGN"
  referenceId    String?
  idempotencyKey String?             @unique
  status         RewardTxStatus      @default(COMPLETED)
  descriptionAr  String
  descriptionEn  String
  expiresAt      DateTime?
  createdBy      String?             // userId or "SYSTEM"
  metadata       String?             // JSON string
  createdAt      DateTime            @default(now())

  @@index([customerId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([idempotencyKey])
  @@index([accountId])
}

/// Temporary coin reservation during active checkout sessions (§17)
model CoinReservation {
  id             String                @id @default(uuid())
  customerId     String
  customer       User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  coins          Int
  discountAmount Float
  conversionRate Float                 @default(100.0) // 100 coins = 1 YER
  status         CoinReservationStatus @default(RESERVED)
  quoteVersion   String
  idempotencyKey String?               @unique
  expiresAt      DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([customerId, status])
  @@index([orderId])
  @@index([expiresAt])
  @@index([idempotencyKey])
}

/// Admin-configurable Rewards Rules & Conversion Rates (§12, §13, §64, §112)
model RewardRuleConfig {
  id                     String   @id @default(uuid())
  key                    String   @unique @default("global_reward_rules")
  purchaseRewardRate     Float    @default(0.01) // 1 coin per 100 YER spent (1%)
  minPurchaseForReward   Float    @default(500.0)
  maxRewardPerOrder      Int      @default(5000)
  reviewTextReward       Int      @default(20)
  reviewPhotoReward      Int      @default(50)
  reviewVideoReward      Int      @default(100)
  referralReferrerReward Int      @default(100)
  referralRefereeReward  Int      @default(50)
  referralMinOrderAmount Float    @default(1000.0)
  redemptionRatio        Float    @default(100.0) // 100 coins = 1 currency unit
  maxOrderPercentage     Float    @default(0.20)  // max 20% order subtotal
  maxCoinsPerOrder       Int      @default(2000)
  minCoinsRequired       Int      @default(50)
  minOrderAmount         Float    @default(200.0)
  defaultExpirationDays  Int      @default(180)
  warningDays            Int      @default(7)
  coinsCoverDelivery     Boolean  @default(false)
  negativeBalanceAllowed Boolean  @default(false)
  version                String   @default("1.0.0")
  updatedAt              DateTime @updatedAt
}

/// Gamified Tasks & Missions for Customers (§28, §29, §30, §31, §65)
model RewardMission {
  id                 String                    @id @default(uuid())
  titleAr            String
  titleEn            String
  descriptionAr      String
  descriptionEn      String
  type               MissionType
  target             Int                       @default(1)
  rewardCoins        Int
  badgeIcon          String?
  startAt            DateTime
  endAt              DateTime
  status             MissionStatus             @default(ACTIVE)
  eligibility        String?                   // JSON string
  maxCompletions     Int?                      // Global completion cap
  currentCompletions Int                       @default(0)
  perCustomerLimit   Int                       @default(1)
  metadata           String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  progressRecords    CustomerMissionProgress[]

  @@index([status, startAt, endAt])
  @@index([type])
}

/// Tracks customer progress and claims per mission (§30)
model CustomerMissionProgress {
  id                  String        @id @default(uuid())
  customerId          String
  customer            User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  missionId           String
  mission             RewardMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress            Int           @default(0)
  target              Int
  completed           Boolean       @default(false)
  completedAt         DateTime?
  claimed             Boolean       @default(false)
  claimedAt           DateTime?
  rewardTransactionId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([customerId, missionId])
  @@index([customerId, completed])
}

/// Daily Check-in claim records (§24, §25, §26)
model DailyCheckin {
  id                  String   @id @default(uuid())
  customerId          String
  customer            User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  checkinDate         String   // "YYYY-MM-DD" in Asia/Aden timezone
  dayIndex            Int      // 1..7
  coinsAwarded        Int
  streakCount         Int
  rewardTransactionId String?
  createdAt           DateTime @default(now())

  @@unique([customerId, checkinDate])
  @@index([customerId, createdAt])
}

/// 7-day schedule configuration for Daily Check-in rewards (§24, §66)
model DailyCheckinSchedule {
  id          String   @id @default(uuid())
  dayNumber   Int      @unique // 1..7
  rewardCoins Int
  bonusCoins  Int      @default(0)
  labelAr     String
  labelEn     String
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

/// Customer referral records and reward tracking (§35, §36)
model ReferralRecord {
  id                  String               @id @default(uuid())
  referrerId          String
  referrer            User                 @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId           String               @unique
  referee             User                 @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: Cascade)
  referralCode        String
  status              ReferralRecordStatus @default(REGISTERED)
  firstOrderId        String?
  firstOrderAmount    Float?
  referrerRewardCoins Int                  @default(0)
  refereeRewardCoins  Int                  @default(0)
  referrerRewardTxId  String?
  refereeRewardTxId   String?
  completedAt         DateTime?
  fraudSuspected      Boolean              @default(false)
  fraudReason         String?
  createdAt           DateTime             @default(now())

  @@index([referrerId])
  @@index([refereeId])
  @@index([referralCode])
  @@index([status])
}

/// Mega campaigns, Double-Date bonuses, and multiplier campaigns (§37, §38, §39, §67)
model CoinCampaign {
  id                 String              @id @default(uuid())
  name               String
  nameAr             String?
  slug               String              @unique
  descriptionAr      String?
  descriptionEn      String?
  campaignType       CoinCampaignType    @default(MEGA_CAMPAIGN)
  fundingSource      RewardFundingSource @default(PLATFORM)
  sellerId           String?
  seller             Seller?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  startAt            DateTime
  endAt              DateTime
  multiplier         Float               @default(1.0) // 1.0x, 2.0x, 3.0x
  bonusCoins         Int                 @default(0)
  minOrderAmount     Float?
  maxRewardPerOrder  Int?
  allocatedBudget    Float?
  spentBudget        Float               @default(0.0)
  totalCoinsIssued   Int                 @default(0)
  maxParticipants    Int?
  participantCount   Int                 @default(0)
  eligibleProducts   String?             // JSON array string
  eligibleCategories String?             // JSON array string
  eligibleSellers    String?             // JSON array string
  status             CoinCampaignStatus  @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, startAt, endAt])
  @@index([sellerId])
}

/// Seller-funded promotional coin budget tracking (§40, §43, §69)
model SellerRewardBudget {
  id                   String   @id @default(uuid())
  sellerId             String   @unique
  seller               Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  allocatedBudget      Float    @default(0.0)
  spentBudget          Float    @default(0.0)
  remainingBudget      Float    @default(0.0)
  maxRewardPerCustomer Int      @default(500)
  maxRewardPerOrder    Int      @default(200)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Comprehensive audit log for manual coin adjustments and administrative actions (§71, §73)
model RewardAuditLog {
  id               String   @id @default(uuid())
  adminId          String
  admin            User     @relation("RewardAuditCreator", fields: [adminId], references: [id], onDelete: Cascade)
  action           String   // "MANUAL_CREDIT", "MANUAL_DEBIT", "RULE_UPDATE", "FLAG_RESOLVE"
  resource         String   // "rewards", "missions", "campaigns"
  targetCustomerId String?
  targetCustomer   User?    @relation("RewardAuditTarget", fields: [targetCustomerId], references: [id], onDelete: SetNull)
  details          String   // JSON string
  ipAddress        String?
  createdAt        DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetCustomerId])
}// ==========================================
// REMOTE CONFIGURATION & FEATURE FLAGS SYSTEM
// ==========================================

/// Feature flag definition for Remote Configuration & Feature Flags System
model FeatureFlag {
  id                   String                @id @default(uuid())
  key                  String                @unique // e.g. "online_payment", "cash_on_delivery"
  enabled              Boolean               @default(false)
  displayNameAr        String
  displayNameEn        String
  descriptionAr        String?
  descriptionEn        String?
  maintenanceMessageAr String?
  maintenanceMessageEn String?
  rolloutPercentage    Int                   @default(100) // 0 - 100
  startDate            DateTime?             // scheduled activation time
  endDate              DateTime?             // scheduled expiration time
  platforms            String                @default("[\"android\",\"ios\",\"web\"]") // JSON array
  dependencies         String                @default("[]") // JSON array of required feature keys
  metadata             String                @default("{}") // JSON object for sub-configurations (e.g. wallet providers)
  configVersion        Int                   @default(1)
  isSensitive          Boolean               @default(false) // requires admin confirmation to toggle
  updatedBy            String?               // admin user id or email
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  auditLogs            FeatureFlagAuditLog[]

  @@index([key])
  @@index([enabled])
  @@index([updatedAt])
}

/// Audit log for every configuration and feature flag alteration
model FeatureFlagAuditLog {
  id            String       @id @default(uuid())
  featureFlagId String?
  featureFlag   FeatureFlag? @relation(fields: [featureFlagId], references: [id], onDelete: SetNull)
  featureKey    String
  action        String       // "TOGGLE_ON", "TOGGLE_OFF", "UPDATE_CONFIG", "ROLLOUT_UPDATE", "EMERGENCY_DISABLE"
  oldValue      String?      // JSON string of previous state
  newValue      String?      // JSON string of updated state
  reason        String?
  changedBy     String?      // User ID or name/email of the admin
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())

  @@index([featureKey])
  @@index([changedBy])
  @@index([createdAt])
}

// ==========================================
// TAX ENGINE MODULE ENUMS & MODELS
// ==========================================

enum TaxCalculationMethod {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TaxTargetType {
  DEFAULT
  PRODUCT
  CATEGORY
  SELLER
}

enum TaxExemptionEntityType {
  PRODUCT
  CATEGORY
  SELLER
  CUSTOMER
}

enum TaxAuditAction {
  CREATE
  UPDATE
  ACTIVATE
  DEACTIVATE
  EXEMPT
  REMOVE_EXEMPTION
  VERSION_CREATED
}

enum DiscountTaxTreatment {
  AFTER_DISCOUNT
  BEFORE_DISCOUNT
}

enum RoundingStrategy {
  HALF_UP
  HALF_DOWN
  FLOOR
  CEILING
}

enum RoundingLevel {
  LINE_ITEM
  ORDER_LEVEL
}

/// Centralized marketplace tax rule
model TaxRule {
  id                    String                @id @default(uuid())
  name                  String
  code                  String
  description           String?
  rate                  Float                 // Rate in decimal, e.g. 0.05 for 5%, or fixed amount
  calculationMethod     TaxCalculationMethod  @default(PERCENTAGE)
  priceIncludesTax      Boolean               @default(false)
  appliesToProducts     Boolean               @default(true)
  appliesToShipping     Boolean               @default(false)
  appliesToPlatformFees Boolean               @default(false)
  appliesToPaymentFees  Boolean               @default(false)
  appliesToDiscounts    Boolean               @default(true)
  active                Boolean               @default(true)
  priority              Int                   @default(100)
  targetType            TaxTargetType         @default(DEFAULT)
  targetId              String?               // productId, categoryId, or sellerId
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  createdBy             String?
  updatedBy             String?
  version               Int                   @default(1)
  parentRuleId          String?
  isArchived            Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  snapshots             OrderTaxSnapshot[]
  auditLogs             TaxAuditLog[]

  @@index([code])
  @@index([active])
  @@index([targetType, targetId])
  @@index([priority])
  @@index([effectiveFrom, effectiveUntil])
}

/// Tax exemption rule for entities
model TaxExemption {
  id          String                 @id @default(uuid())
  entityType  TaxExemptionEntityType
  entityId    String                 // productId, categoryId, sellerId, or userId
  reason      String
  validFrom   DateTime?
  validUntil  DateTime?
  active      Boolean                @default(true)
  createdBy   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  auditLogs   TaxAuditLog[]

  @@index([entityType, entityId])
  @@index([active])
}

/// Permanent, immutable tax snapshot stored at checkout
model OrderTaxSnapshot {
  id                String       @id @default(uuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId     String?
  sellerOrder       SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  orderItemId       String?
  orderItem         OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  sellerId          String?
  taxRuleId         String?
  taxRule           TaxRule?     @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  taxRuleVersion    Int          @default(1)
  taxName           String
  taxRate           Float
  taxableAmount     Float
  taxAmount         Float
  calculationMethod String       @default("PERCENTAGE")
  priceIncludesTax  Boolean      @default(false)
  discountAmount    Float        @default(0.0)
  shippingTax       Float        @default(0.0)
  feeTax            Float        @default(0.0)
  currency          String       @default("YER")
  calculatedAt      DateTime     @default(now())
  metadata          String?      // JSON metadata for full breakdown and audit

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([orderItemId])
  @@index([sellerId])
  @@index([taxRuleId])
  @@index([calculatedAt])
}

/// Immutable record of tax refunds
model RefundTaxRecord {
  id                   String         @id @default(uuid())
  refundId             String
  refundRequest        RefundRequest  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId        String?
  orderItemId          String?
  originalTax          Float
  refundedTax          Float
  remainingTax         Float
  calculationReference String         // e.g. "ITEM_PRORATED", "FULL_ORDER", "MANUAL_ADJUSTMENT"
  createdAt            DateTime       @default(now())

  @@index([refundId])
  @@index([orderId])
  @@index([orderItemId])
}

/// Audit log for tax rule & exemption mutations
model TaxAuditLog {
  id            String          @id @default(uuid())
  adminId       String?
  action        TaxAuditAction
  ruleId        String?
  taxRule       TaxRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  exemptionId   String?
  taxExemption  TaxExemption?   @relation(fields: [exemptionId], references: [id], onDelete: SetNull)
  previousValue String?         // JSON
  newValue      String?         // JSON
  reason        String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())

  @@index([ruleId])
  @@index([exemptionId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

/// System-level Tax Configuration
model TaxConfiguration {
  id                          String                @id @default("global")
  taxEnabled                  Boolean               @default(true)
  taxInclusivePrices          Boolean               @default(false)
  taxOnShippingEnabled        Boolean               @default(false)
  taxOnPlatformFeesEnabled    Boolean               @default(false)
  taxOnPaymentFeesEnabled     Boolean               @default(false)
  discountTreatment           DiscountTaxTreatment  @default(AFTER_DISCOUNT)
  roundingStrategy            RoundingStrategy      @default(HALF_UP)
  roundingLevel               RoundingLevel         @default(LINE_ITEM)
  defaultTaxRuleId            String?
  defaultRate                 Float                 @default(0.05)
  currency                    String                @default("YER")
  version                     Int                   @default(1)
  updatedBy                   String?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
}

// ==========================================
// SOUQNAA FINANCIAL STATEMENTS & SETTLEMENT ENGINE
// ==========================================

enum StatementType {
  SELLER_STATEMENT
  SETTLEMENT_STATEMENT
  COMMISSION_STATEMENT
  TAX_STATEMENT
}

enum StatementStatus {
  DRAFT
  GENERATING
  READY
  FINALIZED
  FAILED
  SUPERSEDED
}

enum StatementPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum StatementLineType {
  SALE
  DISCOUNT
  REFUND
  TAX
  COMMISSION
  ADJUSTMENT
  SETTLEMENT_PAYOUT
  WITHDRAWAL
  FEE
}

enum StatementAuditAction {
  STATEMENT_CREATED
  STATEMENT_GENERATED
  STATEMENT_VIEWED
  STATEMENT_DOWNLOADED
  STATEMENT_EXPORTED
  STATEMENT_FINALIZED
  STATEMENT_SUPERSEDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

model Settlement {
  id                    String             @id @default(uuid())
  settlementNumber      String             @unique // e.g. SET-2026-000123
  sellerId              String
  seller                Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  periodStart           DateTime
  periodEnd             DateTime
  settlementDate        DateTime?
  currency              String             @default("YER")
  status                SettlementStatus   @default(PENDING)
  grossSales            Float              @default(0.0)
  discounts             Float              @default(0.0)
  refunds               Float              @default(0.0)
  commissionAmount      Float              @default(0.0)
  taxAdjustments        Float              @default(0.0)
  feeAmount             Float              @default(0.0)
  authorizedAdjustments Float              @default(0.0)
  deliveryReimbursementTotal  Float              @default(0.0)
  sellerShippingContributionTotal Float          @default(0.0)
  netSettlementAmount   Float              @default(0.0)
  paymentReference      String?
  payoutMethod          String?            // BANK_TRANSFER, WALLET, CASH
  withdrawalId          String?
  notes                 String?
  processedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  items                 SettlementItem[]
  statements            FinancialStatement[]

  @@index([sellerId])
  @@index([status])
  @@index([settlementNumber])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
  @@index([sellerId, status, createdAt(sort: Desc)])
}

model SettlementItem {
  id                  String        @id @default(uuid())
  settlementId        String
  settlement          Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  sellerOrderId       String?
  sellerOrder         SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  orderId             String?
  orderNumber         String?
  orderDate           DateTime
  grossSales          Float         @default(0.0)
  discount            Float         @default(0.0)
  refund              Float         @default(0.0)
  tax                 Float         @default(0.0)
  commission          Float         @default(0.0)
  otherFees           Float         @default(0.0)
  originalDeliveryFee Float         @default(0.0)
  deliveryReimbursement Float       @default(0.0)
  sellerShippingContribution Float  @default(0.0)
  netSellerAmount     Float         @default(0.0)
  currency            String        @default("YER")
  createdAt           DateTime      @default(now())

  @@index([settlementId])
  @@index([sellerOrderId])
  @@index([orderId])
}

model FinancialStatement {
  id                      String                @id @default(uuid())
  statementNumber         String                @unique // SQ-SELL-STMT-YYYY-XXXXXX, SQ-SET-STMT-..., etc.
  statementType           StatementType
  status                  StatementStatus       @default(DRAFT)
  periodType              StatementPeriodType?
  periodStart             DateTime
  periodEnd               DateTime
  timezone                String                @default("Asia/Aden")
  currency                String                @default("YER")
  sellerId                String
  seller                  Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  settlementId            String?               @unique
  settlement              Settlement?           @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  withdrawalId            String?
  withdrawal              Withdrawal?           @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  version                 Int                   @default(1)
  statementEngineVersion  String                @default("1.0.0")
  taxEngineVersion        String                @default("1.0.0")
  commissionEngineVersion String                @default("1.0.0")
  settlementEngineVersion String                @default("1.0.0")
  pdfUrl                  String?
  finalizedAt             DateTime?
  supersededAt            DateTime?
  supersededById          String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  snapshot                StatementSnapshot?
  lines                   StatementLine[]
  auditLogs               StatementAuditLog[]
  versions                StatementVersionHistory[]

  @@index([sellerId, statementType, periodStart, periodEnd])
  @@index([sellerId])
  @@index([statementType])
  @@index([status])
  @@index([statementNumber])
  @@index([periodStart, periodEnd])
  @@index([settlementId])
  @@index([withdrawalId])
  @@index([createdAt])
}

model StatementSnapshot {
  id                  String             @id @default(uuid())
  statementId         String             @unique
  statement           FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementNumber     String
  statementType       StatementType
  sellerId            String
  settlementId        String?
  periodStart         DateTime
  periodEnd           DateTime
  currency            String             @default("YER")
  summary             String             // JSON stringified summary metrics
  lineItems           String             // JSON stringified line items
  sourceReferences    String             // JSON stringified list of IDs
  calculationVersions String             // JSON stringified versions
  metadata            String?            // JSON stringified store info, verification hash, etc.
  createdAt           DateTime           @default(now())

  @@index([sellerId])
  @@index([statementType])
  @@index([createdAt])
}

model StatementLine {
  id               String             @id @default(uuid())
  statementId      String
  statement        FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  lineIndex        Int
  transactionDate  DateTime
  reference        String
  orderId          String?
  sellerOrderId    String?
  transactionId    String?
  type             StatementLineType
  description      String
  grossAmount      Float              @default(0.0)
  discountAmount   Float              @default(0.0)
  taxAmount        Float              @default(0.0)
  commissionAmount Float              @default(0.0)
  adjustmentAmount Float              @default(0.0)
  feeAmount        Float              @default(0.0)
  netAmount        Float              @default(0.0)
  currency         String             @default("YER")
  status           String             @default("COMPLETED")
  sourceType       String?
  sourceId         String?
  metadata         String?            // JSON
  createdAt        DateTime           @default(now())

  @@index([statementId])
  @@index([orderId])
  @@index([sellerOrderId])
  @@index([transactionId])
  @@index([sourceId])
  @@index([type])
  @@index([transactionDate])
}

model StatementSequence {
  id            String        @id @default(uuid())
  statementType StatementType
  year          Int
  currentValue  Int           @default(0)
  updatedAt     DateTime      @updatedAt

  @@unique([statementType, year])
}

model StatementVersionHistory {
  id                      String             @id @default(uuid())
  statementId             String
  statement               FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  version                 Int
  statementEngineVersion  String
  taxEngineVersion        String
  commissionEngineVersion String
  settlementEngineVersion String
  changeReason            String?
  createdAt               DateTime           @default(now())

  @@index([statementId])
}

model StatementAuditLog {
  id            String               @id @default(uuid())
  statementId   String
  statement     FinancialStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementType StatementType
  action        StatementAuditAction
  actorId       String
  actorRole     String?
  reason        String?
  metadata      String?              // JSON
  createdAt     DateTime             @default(now())

  @@index([statementId])
  @@index([statementType])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// 50. ADVANCED SELLER & ADMIN ANALYSIS ENGINE
// ==========================================

enum AnalyticsFreshness {
  REAL_TIME
  NEAR_REAL_TIME
  DAILY_AGGREGATED
  HISTORICAL
}

enum AnalyticsTrendDirection {
  RISING
  STABLE
  DECLINING
  VOLATILE
}

enum AnalyticsAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalyticsAlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AnalyticsAlertType {
  SALES_DROP
  ORDER_DROP
  REFUND_SPIKE
  CANCELLATION_SPIKE
  SELLER_PERFORMANCE_CHANGE
  OUT_OF_STOCK_DEMAND
  PAYMENT_FAILURE_SPIKE
  SETTLEMENT_FAILURE_SPIKE
  ANOMALY_DETECTED
}

enum AnalyticsRecommendationType {
  RESTOCK_RECOMMENDATION
  PRICE_REVIEW_RECOMMENDATION
  PROMOTION_REVIEW
  LOW_CONVERSION_PRODUCT
  HIGH_REFUND_PRODUCT
  CUSTOMER_RETENTION_OPPORTUNITY
}

enum AnalyticsCustomerSegment {
  NEW_CUSTOMER
  RETURNING_CUSTOMER
  HIGH_VALUE
  FREQUENT_BUYER
  INACTIVE
  AT_RISK
  ONE_TIME_BUYER
}

model AnalyticsDailyMetric {
  id                String   @id @default(uuid())
  date              DateTime
  sellerId          String?  // null for platform-wide metrics
  grossSales        Float    @default(0.0)
  netSales          Float    @default(0.0)
  totalOrders       Int      @default(0)
  completedOrders   Int      @default(0)
  cancelledOrders   Int      @default(0)
  refundedOrders    Int      @default(0)
  unitsSold         Int      @default(0)
  aov               Float    @default(0.0)
  commissionAmount  Float    @default(0.0)
  taxAmount         Float    @default(0.0)
  deliveryFeeAmount Float    @default(0.0)
  discountAmount    Float    @default(0.0)
  currency          String   @default("YER")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date, sellerId])
  @@index([date])
  @@index([sellerId])
}

model AnalyticsProductMetric {
  id                String   @id @default(uuid())
  date              DateTime
  productId         String
  sellerId          String
  unitsSold         Int      @default(0)
  revenue           Float    @default(0.0)
  ordersCount       Int      @default(0)
  viewsCount        Int      @default(0)
  cartAddsCount     Int      @default(0)
  wishlistAddsCount Int      @default(0)
  refundsCount      Int      @default(0)
  conversionRate    Float    @default(0.0)
  refundRate        Float    @default(0.0)
  currency          String   @default("YER")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date, productId])
  @@index([date])
  @@index([productId])
  @@index([sellerId])
}

model AnalyticsAlert {
  id              String                 @id @default(uuid())
  alertType       AnalyticsAlertType
  sellerId        String?                // null for platform admin alerts
  metric          String
  threshold       Float
  observedValue   Float
  comparisonValue Float?
  severity        AnalyticsAlertSeverity @default(MEDIUM)
  status          AnalyticsAlertStatus   @default(NEW)
  titleAr         String
  titleEn         String
  messageAr       String
  messageEn       String
  metadata        String?                // JSON
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  resolvedBy      String?

  @@index([alertType])
  @@index([sellerId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model AnalyticsInsight {
  id               String                       @id @default(uuid())
  sellerId         String?                      // null for marketplace
  type             AnalyticsRecommendationType?
  category         String                       // "SALES", "INVENTORY", "CUSTOMER", "PROMOTION", "PERFORMANCE"
  metric           String
  source           String                       // explainable authoritative origin
  calculation      String                       // explainable calculation method
  titleAr          String
  titleEn          String
  descriptionAr    String
  descriptionEn    String
  recommendationAr String?
  recommendationEn String?
  comparisonPeriod String?
  confidenceScore  Float                        @default(1.0)
  metadata         String?                      // JSON
  createdAt        DateTime                     @default(now())
  expiresAt        DateTime?

  @@index([sellerId])
  @@index([category])
  @@index([createdAt])
}

model AnalyticsSnapshot {
  id             String   @id @default(uuid())
  snapshotNumber String   @unique
  snapshotType   String   // "SELLER_OVERVIEW", "ADMIN_MARKETPLACE", "SALES_BREAKDOWN", etc.
  sellerId       String?
  periodStart    DateTime
  periodEnd      DateTime
  dataVersion    String   @default("1.0.0")
  sourceVersions String?  // JSON
  filters        String?  // JSON
  metrics        String   // JSON aggregated data
  actorId        String
  actorRole      String
  createdAt      DateTime @default(now())

  @@index([snapshotNumber])
  @@index([snapshotType])
  @@index([sellerId])
  @@index([createdAt])
}

model AnalyticsAuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actorRole String
  sellerId  String?
  action    String   // "ANALYTICS_VIEWED", "ANALYTICS_EXPORTED", "REPORT_GENERATED", etc.
  resource  String   // e.g. "SELLER_SALES", "MARKETPLACE_OVERVIEW"
  filters   String?  // JSON
  ipAddress String?
  userAgent String?
  metadata  String?  // JSON
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([sellerId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  eventType   String   // "PRODUCT_VIEWED", "PRODUCT_SEARCHED", "CART_ADD", "WISHLIST_ADD", etc.
  customerId  String?
  sellerId    String?
  productId   String?
  categoryId  String?
  orderId     String?
  sessionId   String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([sellerId])
  @@index([productId])
  @@index([customerId])
  @@index([createdAt])
}

// ==========================================
// CUSTOMER MEMBERSHIP & VIP TIERS ENGINE
// ==========================================

model MembershipTier {
  id                    String              @id @default(uuid())
  code                  String              @unique // REGULAR, MEMBER, PREMIUM, VIP, VIP_PLUS, etc.
  nameAr                String
  nameEn                String
  descriptionAr         String?
  descriptionEn         String?
  level                 Int                 // 0, 1, 2, 3, 4 (deterministic hierarchy)
  priority              Int                 @default(0)
  isActive              Boolean             @default(true)
  icon                  String?             // e.g. "crown", "star", "diamond"
  badgeAssetUrl         String?
  qualificationRules    String              // JSON: { type: "ALL"|"ANY", rules: [...] }
  benefitConfiguration  String              // JSON: { perks: [...], coinsMultiplier: 1.5, freeShipping: true, etc. }
  validityConfiguration String?             // JSON: { periodType: "LIFETIME"|"ROLLING_DAYS"|"CALENDAR_YEAR", days: 365, gracePeriodDays: 30 }
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  memberships           CustomerMembership[]
  overrides             MembershipOverride[]
  auditLogsFrom         MembershipAuditLog[] @relation("PreviousTier")
  auditLogsTo           MembershipAuditLog[] @relation("NewTier")

  @@index([level])
  @@index([isActive])
}

model CustomerMembership {
  id                       String             @id @default(uuid())
  userId                   String             @unique
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId                   String
  tier                     MembershipTier     @relation(fields: [tierId], references: [id])
  status                   MembershipStatus   @default(ACTIVE)
  startedAt                DateTime           @default(now())
  expiresAt                DateTime?
  renewedAt                DateTime?
  gracePeriodEnd           DateTime?
  qualificationPeriodStart DateTime?
  qualificationPeriodEnd   DateTime?
  lifetimeSpend            Float              @default(0)
  periodSpend              Float              @default(0)
  completedOrders          Int                @default(0)
  periodCompletedOrders    Int                @default(0)
  pointsBalance            Int                @default(0)
  lastEvaluatedAt          DateTime?
  nextEvaluationAt         DateTime?
  version                  Int                @default(1)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  overrides                MembershipOverride[]

  @@index([userId])
  @@index([tierId])
  @@index([status])
  @@index([nextEvaluationAt])
  @@index([qualificationPeriodStart, qualificationPeriodEnd])
}

model MembershipOverride {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId   String?
  membership     CustomerMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  overrideTierId String
  overrideTier   MembershipTier      @relation(fields: [overrideTierId], references: [id])
  reason         String
  startAt        DateTime            @default(now())
  endAt          DateTime?
  createdBy      String              // Admin user ID
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@index([overrideTierId])
  @@index([isActive])
}

model MembershipAuditLog {
  id              String                    @id @default(uuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId         String                    // Admin user ID or "SYSTEM"
  actorRole       String                    // "ADMIN" | "SYSTEM" | "CUSTOMER"
  changeType      MembershipAuditChangeType
  previousTierId  String?
  previousTier    MembershipTier?           @relation("PreviousTier", fields: [previousTierId], references: [id])
  newTierId       String
  newTier         MembershipTier            @relation("NewTier", fields: [newTierId], references: [id])
  reason          String?
  metricsSnapshot String?                   // JSON snapshot of spend, orders, etc.
  correlationId   String?
  createdAt       DateTime                  @default(now())

  @@index([userId])
  @@index([actorId])
  @@index([changeType])
  @@index([createdAt])
}

// ==========================================
// APP LIFECYCLE, VERSION POLICY & DISTRIBUTION (§14, §15, §16, §29, §30, §38)
// ==========================================

enum AppTypeEnum {
  CUSTOMER
  SELLER
  ADMIN
}

enum AppPlatformEnum {
  ANDROID
  IOS
  WINDOWS
  WEB
}

enum AppDeviceTypeEnum {
  PHONE
  TABLET
  DESKTOP
}

enum ReleaseStatusEnum {
  DRAFT
  SCHEDULED
  PUBLISHED
  ROLLED_BACK
  RETIRED
}

enum ReleaseChannelEnum {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

model AppRelease {
  id               String             @id @default(uuid())
  appType          AppTypeEnum
  platform         AppPlatformEnum
  deviceType       AppDeviceTypeEnum?
  version          String
  buildNumber      Int
  releaseDate      DateTime           @default(now())
  releaseNotesAr   String?            @db.Text
  releaseNotesEn   String?            @db.Text
  status           ReleaseStatusEnum  @default(DRAFT)
  isLatest         Boolean            @default(false)
  isRecommended    Boolean            @default(true)
  minimumSupported Boolean            @default(false)
  storeUrl         String?
  releaseChannel   ReleaseChannelEnum @default(PRODUCTION)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([appType, platform, status])
  @@index([appType, platform, releaseChannel])
  @@index([version, buildNumber])
  @@map("app_releases")
}

model AppVersionPolicy {
  id                      String             @id @default(uuid())
  appType                 AppTypeEnum
  platform                AppPlatformEnum
  deviceType              AppDeviceTypeEnum?
  latestVersion           String
  latestBuild             Int
  minimumSupportedVersion String
  minimumSupportedBuild   Int
  forceUpdateEnabled      Boolean            @default(true)
  optionalUpdateEnabled   Boolean            @default(true)
  releaseNotesEnabled     Boolean            @default(true)
  active                  Boolean            @default(true)
  environment             ReleaseChannelEnum @default(PRODUCTION)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([appType, platform, deviceType, environment, active])
  @@index([environment, active])
  @@map("app_version_policies")
}

model AppStoreLink {
  id                   String          @id @default(uuid())
  appType              AppTypeEnum
  platform             AppPlatformEnum
  storeName            String
  storeUrl             String
  packageIdentifier    String?
  bundleIdentifier     String?
  windowsAppIdentifier String?
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([appType, platform, active])
  @@map("app_store_links")
}

model AppUpdateEvent {
  id             String             @id @default(uuid())
  appType        AppTypeEnum
  platform       AppPlatformEnum
  deviceType     AppDeviceTypeEnum?
  currentVersion String
  currentBuild   Int
  targetVersion  String?
  targetBuild    Int?
  eventType      String             // CHECKED, CURRENT, OPTIONAL_UPDATE_AVAILABLE, MANDATORY_UPDATE, PROMPT_SHOWN, UPDATE_ACCEPTED, UPDATE_DISMISSED, UPDATE_STARTED, UPDATE_COMPLETED, UPDATE_FAILED, STORE_OPENED
  timestamp      DateTime           @default(now())
  sessionId      String?
  environment    ReleaseChannelEnum @default(PRODUCTION)

  @@index([appType, platform, eventType])
  @@index([timestamp])
  @@index([environment])
  @@map("app_update_events")
}

model AppRatingEvent {
  id             String             @id @default(uuid())
  appType        AppTypeEnum
  platform       AppPlatformEnum
  deviceType     AppDeviceTypeEnum?
  currentVersion String
  eventType      String             // ELIGIBILITY_CHECKED, PROMPT_SHOWN, PROMPT_ACCEPTED, PROMPT_DISMISSED, REQUEST_STARTED, REQUEST_COMPLETED, REQUEST_SKIPPED
  timestamp      DateTime           @default(now())
  sessionId      String?
  environment    ReleaseChannelEnum @default(PRODUCTION)

  @@index([appType, platform, eventType])
  @@index([timestamp])
  @@map("app_rating_events")
}

model AppReleaseAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entityId  String?
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  timestamp DateTime @default(now())
  requestId String?

  @@index([adminId])
  @@index([action])
  @@index([timestamp])
  @@map("app_release_audit_logs")
}

model AppMaintenanceRule {
  id                   String             @id @default(uuid())
  appType              AppTypeEnum?
  platform             AppPlatformEnum?
  deviceType           AppDeviceTypeEnum?
  enabled              Boolean            @default(false)
  isEmergency          Boolean            @default(false)
  maintenanceStart     DateTime?
  maintenanceEnd       DateTime?
  maintenanceMessageAr String?            @db.Text
  maintenanceMessageEn String?            @db.Text
  allowBrowsing        Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([enabled])
  @@index([appType, platform])
  @@map("app_maintenance_rules")
}

// ==========================================
// 27. CUSTOMER ACTION CENTER ENGINE
// ==========================================

model CustomerActionDismissal {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deduplicationKey String
  actionType       String
  dismissedAt      DateTime  @default(now())
  snoozedUntil     DateTime?

  @@unique([userId, deduplicationKey])
  @@index([userId, snoozedUntil])
  @@map("customer_action_dismissals")
}

model CustomerActionAnnouncement {
  id            String    @id @default(uuid())
  titleAr       String
  titleEn       String
  descriptionAr String
  descriptionEn String
  category      String    @default("PLATFORM")
  priority      String    @default("MEDIUM")
  ctaLabelAr    String?
  ctaLabelEn    String?
  deepLink      String?
  icon          String?   @default("campaign")
  imageUrl      String?
  targetTier    String?
  targetSegment String?
  isActive      Boolean   @default(true)
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  dismissible   Boolean   @default(true)
  snoozable     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, startsAt, expiresAt])
  @@map("customer_action_announcements")
}

// ── SOUQNAA SELLER PERFORMANCE SCORE ENGINE ─────────────────────────────────

enum PerformanceGrade {
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  NEEDS_IMPROVEMENT
  INSUFFICIENT_DATA
}

enum PerformanceDataStatus {
  INSUFFICIENT_DATA
  PROVISIONAL
  ESTABLISHED
}

model SellerPerformance {
  id                         String                @id @default(uuid())
  sellerId                   String                @unique
  seller                     Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  score                      Float                 @default(0.0) // 0.0 - 100.0
  grade                      PerformanceGrade      @default(INSUFFICIENT_DATA)
  dataStatus                 PerformanceDataStatus @default(INSUFFICIENT_DATA)

  // Component Normalized Scores (0 - 100)
  customerSatisfactionScore Float                 @default(0.0) // 35% weight
  responseTimeScore          Float                 @default(0.0) // 20% weight
  orderCompletionScore       Float                 @default(0.0) // 20% weight
  onTimeFulfillmentScore     Float                 @default(0.0) // 15% weight
  issueRateScore             Float                 @default(0.0) // 10% weight

  // Raw Underlying Metrics
  ratingAverage              Float                 @default(0.0)
  responseRate               Float                 @default(0.0) // 0 - 100%
  medianResponseMinutes      Float                 @default(0.0)
  orderCompletionRate        Float                 @default(0.0) // 0 - 100%
  onTimeFulfillmentRate      Float                 @default(0.0) // 0 - 100%
  sellerCancellationRate     Float                 @default(0.0) // 0 - 100%
  issueRate                  Float                 @default(0.0) // 0 - 100%

  // Volume & Data Sufficiency Counters
  eligibleOrderCount         Int                   @default(0)
  eligibleReviewCount        Int                   @default(0)
  totalConversationsCount    Int                   @default(0)
  answeredConversationsCount Int                   @default(0)

  // Configuration & Engine Metadata
  calculationWindowDays      Int                   @default(30)
  calculationWindow          String                @default("LAST_30_DAYS")
  algorithmVersion           String                @default("1.0.0")
  configVersion              Int                   @default(1)
  calculatedAt               DateTime              @default(now())
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  snapshots                  SellerPerformanceSnapshot[]

  @@index([sellerId])
  @@index([score])
  @@index([grade])
  @@index([dataStatus])
  @@index([calculatedAt])
  @@map("seller_performance")
}

model SellerPerformanceSnapshot {
  id                         String                @id @default(uuid())
  sellerId                   String
  seller                     Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerPerformanceId        String?
  sellerPerformance          SellerPerformance?    @relation(fields: [sellerPerformanceId], references: [id], onDelete: Cascade)

  score                      Float
  grade                      PerformanceGrade
  dataStatus                 PerformanceDataStatus

  customerSatisfactionScore Float
  responseTimeScore          Float
  orderCompletionScore       Float
  onTimeFulfillmentScore     Float
  issueRateScore             Float

  ratingAverage              Float
  responseRate               Float
  medianResponseMinutes      Float
  orderCompletionRate        Float
  onTimeFulfillmentRate      Float
  sellerCancellationRate     Float
  issueRate                  Float

  eligibleOrderCount         Int
  eligibleReviewCount        Int

  calculationWindow          String
  algorithmVersion           String
  configVersion              Int
  triggerReason              String?               // 'SCHEDULED', 'EVENT_ORDER_COMPLETED', 'MANUAL_RECALCULATE', etc.
  metadata                   String?               // JSON metadata with granular stats & recommendations

  calculatedAt               DateTime              @default(now())

  @@index([sellerId])
  @@index([calculatedAt(sort: Desc)])
  @@index([sellerId, calculatedAt(sort: Desc)])
  @@map("seller_performance_snapshots")
}

model SellerPerformanceEvent {
  id             String    @id @default(uuid())
  sellerId       String
  eventType      String    // 'ORDER_COMPLETED', 'ORDER_CANCELLED', 'REVIEW_CREATED', 'CHAT_RESPONDED', 'DISPUTE_RESOLVED'
  entityId       String
  idempotencyKey String    @unique
  payload        String?   // JSON
  processed      Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([sellerId, processed])
  @@index([createdAt])
  @@map("seller_performance_events")
}


